@page "/"
@using GistHub.Components
@using GistHub.Models
@using GistHub.Services
@inject IGithubService Github
@inject AppState AppState
@inject NavigationManager Navigation
@inject IStorageService Storage
@implements IDisposable

<div class="space-y-12">
    <!-- Hero / Welcome -->
    <div class="relative">
        <div class="absolute -top-10 -left-10 w-64 h-64 bg-primary/10 rounded-full blur-3xl -z-10 animate-pulse"></div>
        <div class="absolute -bottom-10 -right-10 w-96 h-96 bg-blue-600/5 rounded-full blur-3xl -z-10 animate-pulse delay-700"></div>
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b">
            <div class="space-y-1">
                <h2 class="text-4xl font-extrabold tracking-tight">Discovery Feed</h2>
                <p class="text-muted-foreground text-lg">Explore latest public snippets from the global community.</p>
            </div>
            
            <div class="flex items-center gap-3">
                @if (AppState.IsAuthenticated)
                {
                    <div class="relative group flex-1 md:w-64">
                        <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-muted-foreground group-focus-within:text-primary transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        </div>
                        <input type="text" 
                               placeholder="Search user profile..." 
                               @bind="TargetUsername"
                               @onkeypress="HandleKeyPress"
                               class="pl-9 pr-4 py-2 bg-card border rounded-xl text-sm font-semibold focus:ring-2 focus:ring-primary/20 outline-none w-full transition-all" />
                    </div>

                    <div class="relative group">
                        <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-muted-foreground group-focus-within:text-primary transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-filter"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                        </div>
                        <select @onchange="OnLanguageFilterChanged" class="pl-9 pr-8 py-2 bg-card border rounded-xl text-sm font-semibold appearance-none focus:ring-2 focus:ring-primary/20 outline-none transition-all cursor-pointer">
                            <option value="">All Languages</option>
                            <option value="C#">CSharp</option>
                            <option value="JavaScript">JavaScript</option>
                            <option value="TypeScript">TypeScript</option>
                            <option value="Python">Python</option>
                        </select>
                    </div>
                }
                
                <button @onclick="NavigateToLogin" class="flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-xl text-sm font-bold shadow-lg shadow-primary/20 hover:scale-105 active:scale-95 transition-all whitespace-nowrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus-circle"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
                    @(AppState.IsAuthenticated ? "New Snippet" : "Connect GitHub")
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="p-4 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-between animate-in fade-in slide-in-from-top-4">
            <span class="text-sm font-bold text-primary">@Message</span>
            <button @onclick='() => Message = ""' class="text-primary hover:scale-110 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </div>
    }

    @if (IsLoading && !Gists.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            @for (int i = 0; i < 6; i++)
            {
                <div class="h-64 bg-muted animate-pulse rounded-2xl"></div>
            }
        </div>
    }
    else if (!Gists.Any())
    {
        <div class="flex flex-col items-center justify-center py-20 border-2 border-dashed rounded-3xl bg-muted/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-inbox text-muted-foreground mb-4 opacity-20"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
            <p class="text-sm font-medium text-muted-foreground">No snippets found in this feed.</p>
            <button @onclick="LoadGists" class="mt-4 text-xs font-bold text-primary underline underline-offset-4">Retry</button>
        </div>
    }
    else
    {
        <!-- Feed Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 gap-6 font-primary pb-32">
        @foreach (var gist in FilteredGists)
        {
            <GistCard 
                Id="@gist.Id"
                Author="@(gist.Owner?.Login ?? "anonymous")" 
                AvatarUrl="@(gist.Owner?.AvatarUrl ?? "https://github.com/identicons/slh.png")"
                TimeAgo="@gist.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")"
                Description="@(string.IsNullOrEmpty(gist.Description) ? "Multiple files..." : gist.Description)"
                Tags="@ParseTags(gist.Description)"
                SnippetPreview="@(gist.Files.Values.FirstOrDefault()?.Content ?? "Click to view code contents...")"
                Stars="0"
                Forks="0"
                IsSelected="@SelectedGistIds.Contains(gist.Id)"
                OnSelectedChanged="@((val) => ToggleSelection(gist.Id, val))"
                OnView="@((id) => Navigation.NavigateTo($"/view/{gist.Id}"))"
                OnClone="@(() => HandleClone(gist))"
            />
        }
    </div>

    <!-- Floating Bulk Actions -->
    @if (SelectedGistIds.Any())
    {
        <div class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 animate-in slide-in-from-bottom-8 duration-500">
            <div class="bg-card/80 backdrop-blur-2xl border border-primary/30 rounded-2xl px-6 py-4 shadow-[0_20px_50px_rgba(0,0,0,0.3)] flex items-center gap-8 ring-4 ring-primary/5">
                <div class="flex flex-col">
                    <span class="text-xs font-black uppercase tracking-widest text-primary">Bulk Actions</span>
                    <span class="text-sm font-bold">@SelectedGistIds.Count items selected</span>
                </div>
                
                <div class="h-8 w-[1px] bg-border"></div>
                
                <div class="flex items-center gap-3">
                    <button @onclick="ClearSelection" class="btn btn-ghost btn-md text-muted-foreground">Cancel</button>
                    <button @onclick="BulkClone" disabled="@IsBulkCloning" class="btn btn-primary btn-md shadow-xl shadow-primary/20">
                        @if (IsBulkCloning)
                        {
                            <div class="w-4 h-4 border-2 border-white/20 border-t-white rounded-full animate-spin mr-2"></div>
                            <span>Cloning @(ClonedCount)/@(SelectedGistIds.Count)...</span>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy-plus mr-2"><path d="M12 2H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><polyline points="22 2 15 2 15 9"/><path d="M12 9h9"/><path d="M16.5 13.5v6"/><path d="M13.5 16.5h6"/></svg>
                            <span>Clone Selected</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
    
    }
    
    @if (IsLoading && Gists.Any())
    {
        <div class="flex flex-col items-center justify-center py-10">
            <div class="w-8 h-8 border-2 border-primary/20 border-t-primary rounded-full animate-spin"></div>
        </div>
    }
</div>

@code {
    private List<LocalGist> Gists = new();
    private HashSet<string> SelectedGistIds = new();
    private string SelectedLanguage = "";
    private string TargetUsername = "";
    private string Message = "";
    private bool IsLoading = false;
    private bool IsBulkCloning = false;
    private int ClonedCount = 0;

    private void ToggleSelection(string id, bool isSelected)
    {
        if (isSelected) SelectedGistIds.Add(id);
        else SelectedGistIds.Remove(id);
    }

    private void ClearSelection() => SelectedGistIds.Clear();

    private async Task BulkClone()
    {
        if (!AppState.IsAuthenticated) { Navigation.NavigateTo("/login"); return; }
        
        IsBulkCloning = true;
        ClonedCount = 0;
        StateHasChanged();

        var idsToClone = SelectedGistIds.ToList();
        foreach (var id in idsToClone)
        {
            var gist = Gists.FirstOrDefault(g => g.Id == id);
            if (gist != null)
            {
                await HandleClone(gist);
                ClonedCount++;
                StateHasChanged();
            }
        }

        IsBulkCloning = false;
        SelectedGistIds.Clear();
        Message = $"Successfully cloned {ClonedCount} snippets!";
        StateHasChanged();
    }

    private IEnumerable<LocalGist> FilteredGists => 
        string.IsNullOrEmpty(SelectedLanguage) 
            ? Gists 
            : Gists.Where(g => g.Files.Values.Any(f => f.Language == SelectedLanguage));

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        await LoadGists();
    }

    private async Task LoadGists()
    {
        IsLoading = true;
        StateHasChanged();

        try 
        {
            if (string.IsNullOrWhiteSpace(TargetUsername))
            {
                Gists = await Github.GetPublicGistsAsync();
            }
            else
            {
                Gists = await Github.GetUserPublicGistsAsync(TargetUsername);
            }
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadGists();
        }
    }

    private async Task HandleClone(LocalGist gist)
    {
        if (!AppState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Message = "Cloning snippet...";
        StateHasChanged();

        try 
        {
            // 1. Get full gist content (in case current is just preview)
            var fullGist = await Github.GetGistByIdAsync(gist.Id);
            if (fullGist == null) return;

            // 2. Create COPY in our account
            var clone = await Github.CreateGistAsync(
                $"{fullGist.Description} (Cloned from @{gist.Owner?.Login})", 
                true, 
                fullGist.Files, 
                AppState.CurrentProfile!.AccessToken
            );

            if (clone != null)
            {
                clone.IsSynced = true;
                clone.Tags = ParseTags(clone.Description);
                await Storage.SaveGistAsync(clone);
                Message = "Snippet successfully cloned to your collection!";
            }
        }
        catch (Exception ex)
        {
            Message = $"Clone failed: {ex.Message}";
        }
        finally
        {
            StateHasChanged();
            // Clear message after 3 seconds
            Task.Delay(3000).ContinueWith(_ => { Message = ""; InvokeAsync(StateHasChanged); });
        }
    }

    private void OnLanguageFilterChanged(ChangeEventArgs e)
    {
        SelectedLanguage = e.Value?.ToString() ?? "";
    }

    private List<string> ParseTags(string description)
    {
        if (string.IsNullOrEmpty(description)) return new List<string>();
        var tags = new List<string>();
        var parts = description.Split(' ');
        foreach(var part in parts)
        {
            if (part.StartsWith("#") && part.Length > 1)
                tags.Add(part.Substring(1).TrimEnd(',', '.', '!'));
        }
        return tags;
    }

    private void NavigateToLogin()
    {
        if (AppState.IsAuthenticated)
        {
             Navigation.NavigateTo("/editor");
        }
        else
        {
            Navigation.NavigateTo("/login");
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
