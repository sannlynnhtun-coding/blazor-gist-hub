@page "/"
@using GistHub.Components
@using GistHub.Models
@using GistHub.Services
@inject IGithubService Github
@inject AppState AppState
@inject NavigationManager Navigation
@implements IDisposable

<div class="space-y-12">
    <!-- Hero / Welcome -->
    <div class="relative">
        <div class="absolute -top-10 -left-10 w-64 h-64 bg-primary/10 rounded-full blur-3xl -z-10 animate-pulse"></div>
        <div class="absolute -bottom-10 -right-10 w-96 h-96 bg-blue-600/5 rounded-full blur-3xl -z-10 animate-pulse delay-700"></div>
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b">
            <div class="space-y-1">
                <h2 class="text-4xl font-extrabold tracking-tight">Discovery Feed</h2>
                <p class="text-muted-foreground text-lg">Explore latest public snippets from the global community.</p>
            </div>
            
            <div class="flex items-center gap-3">
                @if (AppState.IsAuthenticated)
                {
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-muted-foreground group-focus-within:text-primary transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-filter"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                        </div>
                        <select @onchange="OnLanguageFilterChanged" class="pl-9 pr-8 py-2 bg-card border rounded-xl text-sm font-semibold appearance-none focus:ring-2 focus:ring-primary/20 outline-none transition-all cursor-pointer">
                            <option value="">All Languages</option>
                            <option value="C#">CSharp</option>
                            <option value="JavaScript">JavaScript</option>
                            <option value="TypeScript">TypeScript</option>
                            <option value="Python">Python</option>
                        </select>
                    </div>
                }
                
                <button @onclick="NavigateToLogin" class="flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-xl text-sm font-bold shadow-lg shadow-primary/20 hover:scale-105 active:scale-95 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus-circle"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
                    @(AppState.IsAuthenticated ? "New Gist" : "Connect GitHub")
                </button>
            </div>
        </div>
    </div>

    @if (IsLoading && !Gists.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            @for (int i = 0; i < 6; i++)
            {
                <div class="h-64 bg-muted animate-pulse rounded-2xl"></div>
            }
        </div>
    }
    else if (!Gists.Any())
    {
        <div class="flex flex-col items-center justify-center py-20 border-2 border-dashed rounded-3xl bg-muted/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-inbox text-muted-foreground mb-4 opacity-20"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
            <p class="text-sm font-medium text-muted-foreground">No snippets found in this feed.</p>
            <button @onclick="LoadGists" class="mt-4 text-xs font-bold text-primary underline underline-offset-4">Retry</button>
        </div>
    }
    else
    {
        <!-- Feed Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 gap-6">
            @foreach (var gist in FilteredGists)
            {
                <GistCard 
                    Id="@gist.Id"
                    Author="@(gist.Owner?.Login ?? "anonymous")" 
                    AvatarUrl="@(gist.Owner?.AvatarUrl ?? "https://github.com/identicons/slh.png")"
                    TimeAgo="@gist.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")"
                    Description="@(string.IsNullOrEmpty(gist.Description) ? "Multiple files..." : gist.Description)"
                    Tags="@ParseTags(gist.Description)"
                    SnippetPreview="@(gist.Files.Values.FirstOrDefault()?.Content ?? "Click to view code contents...")"
                    Stars="0"
                    Forks="0"
                />
            }
        </div>
    }
    
    @if (IsLoading && Gists.Any())
    {
        <div class="flex flex-col items-center justify-center py-10">
            <div class="w-8 h-8 border-2 border-primary/20 border-t-primary rounded-full animate-spin"></div>
        </div>
    }
</div>

@code {
    private List<LocalGist> Gists = new();
    private string SelectedLanguage = "";
    private bool IsLoading = false;

    private IEnumerable<LocalGist> FilteredGists => 
        string.IsNullOrEmpty(SelectedLanguage) 
            ? Gists 
            : Gists.Where(g => g.Files.Values.Any(f => f.Language == SelectedLanguage));

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        await LoadGists();
    }

    private async Task LoadGists()
    {
        IsLoading = true;
        StateHasChanged();

        try 
        {
            var result = await Github.GetPublicGistsAsync();
            if (result != null)
            {
                Gists = result;
            }
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void OnLanguageFilterChanged(ChangeEventArgs e)
    {
        SelectedLanguage = e.Value?.ToString() ?? "";
    }

    private List<string> ParseTags(string description)
    {
        if (string.IsNullOrEmpty(description)) return new List<string>();
        
        // Simple regex-like tagging parsing from description
        var tags = new List<string>();
        var parts = description.Split(' ');
        foreach(var part in parts)
        {
            if (part.StartsWith("#") && part.Length > 1)
                tags.Add(part.Substring(1).TrimEnd(',', '.', '!'));
        }
        return tags;
    }

    private void NavigateToLogin()
    {
        if (AppState.IsAuthenticated)
        {
            // For now, toggle login for demo
             Navigation.NavigateTo("/login");
        }
        else
        {
            Navigation.NavigateTo("/login");
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
