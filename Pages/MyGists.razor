@page "/my-gists"
@using GistHub.Components
@using GistHub.Models
@using GistHub.Services
@inject IStorageService Storage
@inject AppState AppState
@inject NavigationManager Navigation
@inject IGithubService Github
@inject IJSRuntime JS

<div class="space-y-12 pb-20">
    <!-- Compact Premium Header -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-primary/10">
        <div class="flex items-center gap-6">
            @if (AppState.IsAuthenticated)
            {
                <div class="relative">
                    <div class="w-20 h-20 rounded-2xl border-2 border-background bg-muted overflow-hidden shadow-xl shadow-primary/10 ring-4 ring-primary/5">
                        <img src="@($"https://github.com/{AppState.CurrentProfile?.GithubUsername}.png")" class="w-full h-full object-cover" />
                    </div>
                </div>
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <h1 class="text-2xl font-black tracking-tight">@AppState.CurrentProfile?.Name</h1>
                        <div class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-500 text-[8px] font-black uppercase tracking-widest border border-emerald-500/20">Verified</div>
                    </div>
                    <div class="flex items-center gap-4">
                        <span class="text-xs font-mono font-bold text-primary opacity-70">@@@AppState.CurrentProfile?.GithubUsername</span>
                        <span class="w-1 h-1 rounded-full bg-border"></span>
                        
                        <!-- Mini Stats Inline -->
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                            <span class="flex items-center gap-1"><span class="text-foreground">@TotalGistsCount</span> Gists</span>
                            <span class="flex items-center gap-1"><span class="text-emerald-500">@PublicGistsCount</span> Public</span>
                            <span class="flex items-center gap-1"><span class="text-amber-500">@SecretGistsCount</span> Secret</span>
                            <span class="flex items-center gap-1"><span class="text-primary">@BookmarkedGistsCount</span> Bookmarks</span>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="flex items-center gap-3">
             <button @onclick="SyncGists" disabled="@IsSyncing" class="btn btn-secondary btn-md">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw @(IsSyncing ? "animate-spin" : "")"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
                Sync Cloud
            </button>
            <button @onclick='() => Navigation.NavigateTo("/editor")' class="btn btn-primary btn-md">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus-circle"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
                New Snippet
            </button>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="relative group max-w-2xl mx-auto w-full -mt-6">
        <div class="absolute inset-0 bg-primary/5 blur-xl group-hover:bg-primary/10 transition-all rounded-2xl"></div>
        <div class="relative flex items-center bg-card/50 backdrop-blur-xl border border-primary/20 rounded-2xl px-4 py-2 shadow-2xl transition-all focus-within:border-primary focus-within:ring-4 focus-within:ring-primary/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search text-muted-foreground mr-3"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input 
                type="text" 
                placeholder="Search your gists, files, or tags..." 
                @bind="SearchQuery" 
                @bind:event="oninput"
                class="flex-1 bg-transparent border-none outline-none text-sm font-medium placeholder:text-muted-foreground/50 h-10" />
            
            @if (!string.IsNullOrEmpty(SearchQuery))
            {
                <button @onclick='() => SearchQuery = ""' class="p-1.5 hover:bg-muted rounded-lg transition-all text-muted-foreground">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            }
            
            <div class="ml-4 pl-4 border-l border-border flex items-center gap-2">
                <span class="text-[10px] font-black uppercase tracking-widest text-muted-foreground/50">Filtered</span>
                <span class="text-xs font-black tabular-nums">@FilteredGists.Count</span>
            </div>
        </div>
    </div>

    @if (!AppState.IsAuthenticated)
    {
        <div class="flex flex-col items-center justify-center py-20 border-2 border-dashed rounded-3xl bg-destructive/5">
            <p class="text-sm font-medium text-destructive">You must be connected to GitHub to view your gists.</p>
            <button @onclick='() => Navigation.NavigateTo("/login")' class="mt-4 btn btn-primary btn-md">Connect Now</button>
        </div>
    }
    else if (!LocalGists.Any() && !IsSyncing)
    {
        <div class="flex flex-col items-center justify-center py-20 border-2 border-dashed rounded-3xl bg-muted/10 opacity-50">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-database-zap text-muted-foreground mb-4"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/><path d="M11 20l2-1h5l1 2"/></svg>
            <p class="text-sm font-medium text-muted-foreground">Pulling your gists from GitHub...</p>
        </div>
    }
    else
    {
        @if (!FilteredGists.Any())
        {
            <div class="flex flex-col items-center justify-center py-20 animate-in fade-in zoom-in duration-500">
                <div class="w-16 h-16 rounded-2xl bg-muted/20 flex items-center justify-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-x text-muted-foreground opacity-30"><path d="m13.5 8.5-5 5"/><path d="m8.5 8.5 5 5"/><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </div>
                <h3 class="text-lg font-bold">No gists found</h3>
                <p class="text-sm text-muted-foreground">Try a different keyword or tag.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var gist in FilteredGists)
                {
                    <GistCard 
                        AvatarUrl="@($"https://github.com/{AppState.CurrentProfile?.GithubUsername}.png")"
                        Author="@AppState.CurrentProfile?.GithubUsername" 
                        AuthorName="@AppState.CurrentProfile?.Name"
                        TimeAgo="@gist.UpdatedAt.ToLocalTime().ToString("MMM dd, HH:mm:ss")"
                        Description="@gist.Description"
                        Tags="@gist.Tags"
                        SnippetPreview="@(gist.Files.Values.FirstOrDefault()?.Content ?? "")"
                        Stars="0"
                        Forks="0"
                        IsBookmarked="@gist.IsBookmarked"
                        OnEdit="@(() => Navigation.NavigateTo($"/editor/{gist.Id}"))"
                        OnDelete="@(() => HandleDelete(gist))"
                        OnToggleBookmark="@(() => ToggleBookmark(gist))"
                        OnView="@((id) => Navigation.NavigateTo($"/view/{gist.Id}"))"
                    />
                }
            </div>
        }
    }
</div>

@code {
    private List<LocalGist> LocalGists = new();
    private bool IsSyncing = false;
    private string SearchQuery = "";

    private List<LocalGist> FilteredGists => string.IsNullOrWhiteSpace(SearchQuery) 
        ? LocalGists 
        : LocalGists.Where(g => 
            (g.Description?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) || 
            (g.Files.Values.Any(f => f.Filename?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)) ||
            (g.Tags.Any(t => t.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
        ).ToList();

    private int TotalGistsCount => LocalGists.Count;
    private int PublicGistsCount => LocalGists.Count(g => g.Public);
    private int SecretGistsCount => LocalGists.Count(g => !g.Public);
    private int BookmarkedGistsCount => LocalGists.Count(g => g.IsBookmarked);

    protected override async Task OnInitializedAsync()
    {
        await LoadLocalGists();
        
        // Auto-fetch if no cache
        if (AppState.IsAuthenticated && !LocalGists.Any())
        {
            await SyncGists();
        }
    }

    private async Task LoadLocalGists()
    {
        LocalGists = (await Storage.GetLocalGistsAsync())
                      .OrderByDescending(g => g.UpdatedAt)
                      .ToList();
    }

    private async Task SyncGists()
    {
        if (!AppState.IsAuthenticated) return;
        
        IsSyncing = true;
        StateHasChanged();

        try 
        {
            var userGistsList = await Github.GetUserGistsAsync(AppState.CurrentProfile!.AccessToken);
            if (userGistsList != null)
            {
                // Fetch full details in parallel (to get content)
                var tasks = userGistsList.Select(async gist => 
                {
                    var fullGist = await Github.GetGistByIdAsync(gist.Id, AppState.CurrentProfile!.AccessToken);
                    if (fullGist != null)
                    {
                        fullGist.IsSynced = true;
                        fullGist.Tags = ParseTags(fullGist.Description);
                        await Storage.SaveGistAsync(fullGist);
                    }
                });

                await Task.WhenAll(tasks);
                await LoadLocalGists();
            }
        }
        finally
        {
            IsSyncing = false;
            StateHasChanged();
        }
    }

    private async Task HandleDelete(LocalGist gist)
    {
        if (string.IsNullOrEmpty(gist.Id)) return;
        
        LocalGists.Remove(gist);
        await Storage.DeleteGistAsync(gist.Id);
        StateHasChanged();

        if (AppState.IsAuthenticated)
        {
            await Github.DeleteGistAsync(gist.Id, AppState.CurrentProfile!.AccessToken);
        }
    }

    private List<string> ParseTags(string description)
    {
        if (string.IsNullOrEmpty(description)) return new List<string>();
        var tags = new List<string>();
        var parts = description.Split(' ');
        foreach(var part in parts)
        {
            if (part.StartsWith("#") && part.Length > 1)
                tags.Add(part.Substring(1).TrimEnd(',', '.', '!', '?', ';'));
        }
        return tags;
    }

    private async Task ToggleBookmark(LocalGist gist)
    {
        gist.IsBookmarked = !gist.IsBookmarked;
        await Storage.SaveGistAsync(gist);
        StateHasChanged();
    }
}
