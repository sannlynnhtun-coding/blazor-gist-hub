@page "/slh-collection/{GistId}"
@using GistHub.Models
@using GistHub.Services
@inject IGithubService Github
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AppState AppState

<div class="max-w-7xl mx-auto space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700 pb-20">
    @if (IsLoading)
    {
        <div class="flex flex-col items-center justify-center py-40 space-y-6">
            <div class="w-16 h-16 border-4 border-primary/30 border-t-primary rounded-full animate-spin"></div>
            <p class="text-xl font-black tracking-tight text-muted-foreground uppercase">Loading SLH file...</p>
        </div>
    }
    else if (IsNotFound || ViewingGist == null)
    {
        <div class="p-12 border-2 border-dashed rounded-[2rem] flex flex-col items-center justify-center text-center space-y-6">
            <div class="w-16 h-16 rounded-2xl bg-muted flex items-center justify-center text-muted-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-search"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><circle cx="11.5" cy="14.5" r="2.5"/><path d="M13.25 16.25 15 18"/></svg>
            </div>
            <div class="space-y-2">
                <h2 class="text-2xl font-black tracking-tight">File Not Available</h2>
                <p class="text-sm text-muted-foreground">This file is not a public SLH collection item.</p>
            </div>
            <button @onclick='() => Navigation.NavigateTo("/slh-collection")' class="btn btn-primary btn-md">Back to SLH Collection</button>
        </div>
    }
    else
    {
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-8 border-b">
            <div class="flex items-center gap-6">
                <button @onclick='() => Navigation.NavigateTo("/slh-collection")' class="btn btn-outline btn-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                </button>
                <div class="space-y-1">
                    <div class="flex items-center gap-3">
                        <h1 class="text-4xl font-black tracking-tighter">@ViewingGist.Description</h1>
                        <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-500 text-[10px] font-black uppercase tracking-widest border border-emerald-500/20">Public</span>
                    </div>
                    <div class="flex items-center gap-4 text-sm font-bold text-muted-foreground uppercase tracking-widest">
                        <div class="flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-round"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
                            @@@ViewingGist.Owner?.Login
                        </div>
                        <span class="w-1.5 h-1.5 rounded-full bg-border"></span>
                        <div class="flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                            @ViewingGist.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy, HH:mm:ss")
                        </div>
                        <span class="w-1.5 h-1.5 rounded-full bg-border"></span>
                        <div class="flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-code"><path d="M10 12.5 8 15l2 2.5"/><path d="m14 12.5 2 2.5-2 2.5"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/></svg>
                            @ViewingGist.Files.Keys.FirstOrDefault()
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <button @onclick="HandleCopy" class="btn btn-secondary btn-lg">
                    @if (IsCopied)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check text-emerald-500 animate-in zoom-in duration-300"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-emerald-500">Copied!</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                        <span>Copy Raw</span>
                    }
                </button>
            </div>
        </div>

        <div class="bg-[#0d1117] rounded-[2.5rem] border border-white/5 shadow-2xl relative overflow-hidden group">
            <div class="h-12 bg-white/5 border-b border-white/5 flex items-center justify-between px-8 backdrop-blur-sm">
                <div class="flex gap-1.5">
                    <div class="w-3 h-3 rounded-full bg-destructive/50"></div>
                    <div class="w-3 h-3 rounded-full bg-amber-500/50"></div>
                    <div class="w-3 h-3 rounded-full bg-emerald-500/50"></div>
                </div>
                <div class="flex items-center gap-4">
                    <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest font-black">
                        @ViewingGist.Files.Keys.FirstOrDefault() - UTF-8
                    </span>
                </div>
            </div>

            <div class="p-4 md:p-10 overflow-auto custom-scrollbar bg-transparent min-h-[500px]">
                @if (IsMarkdown)
                {
                    <div @ref="markdownContainer" class="prose prose-invert max-w-none prose-pre:bg-transparent prose-pre:p-0"></div>
                }
                else
                {
                    <pre class="font-mono text-sm md:text-base leading-relaxed text-zinc-100 float-left min-w-full"><code @ref="codeElement" class="@GetLanguageClass(ViewingGist.Files.Keys.FirstOrDefault())">@ViewingGist.Files.Values.FirstOrDefault()?.Content</code></pre>
                }
            </div>
        </div>

        <div class="flex flex-wrap gap-3">
            @foreach (var tag in ViewingGist.Tags)
            {
                <span class="px-3 py-1 rounded-lg bg-primary/5 text-primary text-xs font-black uppercase tracking-widest border border-primary/10 hover:bg-primary/10 transition-colors cursor-pointer">
                    #@tag
                </span>
            }
        </div>
    }
</div>

@code {
    private const string SlhUsername = "sannlynnhtun-coding";

    [Parameter] public string GistId { get; set; } = "";

    private LocalGist? ViewingGist { get; set; }
    private ElementReference codeElement;
    private ElementReference markdownContainer;
    private bool IsLoading = true;
    private bool IsNotFound = false;
    private bool IsCopied = false;
    private bool shouldHighlight = false;
    private bool shouldRenderMarkdown = false;
    private bool IsMarkdown => Path.GetExtension(ViewingGist?.Files.Keys.FirstOrDefault() ?? "").ToLower() == ".md";

    protected override async Task OnParametersSetAsync()
    {
        await LoadGist();
    }

    private async Task LoadGist()
    {
        IsLoading = true;
        IsNotFound = false;
        ViewingGist = null;
        shouldHighlight = false;
        shouldRenderMarkdown = false;
        StateHasChanged();

        var gist = await Github.GetGistByIdAsync(GistId, AppState.CurrentProfile?.AccessToken);
        if (gist == null ||
            !gist.Public ||
            !string.Equals(gist.Owner?.Login, SlhUsername, StringComparison.OrdinalIgnoreCase))
        {
            IsNotFound = true;
            IsLoading = false;
            StateHasChanged();
            return;
        }

        gist.Tags = ParseTags(gist.Description);
        ViewingGist = gist;
        IsLoading = false;

        if (IsMarkdown)
        {
            shouldRenderMarkdown = true;
        }
        else
        {
            shouldHighlight = true;
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldHighlight && codeElement.Id != null)
        {
            shouldHighlight = false;
            await JS.InvokeVoidAsync("highlightCode", codeElement);
        }

        if (shouldRenderMarkdown && markdownContainer.Id != null)
        {
            shouldRenderMarkdown = false;
            var content = ViewingGist?.Files.Values.FirstOrDefault()?.Content ?? "";
            await JS.InvokeVoidAsync("renderMarkdown", markdownContainer, content);
        }
    }

    private async Task HandleCopy()
    {
        var content = ViewingGist?.Files.Values.FirstOrDefault()?.Content;
        if (string.IsNullOrEmpty(content))
        {
            return;
        }

        await JS.InvokeVoidAsync("copyToClipboard", content);
        IsCopied = true;
        StateHasChanged();

        await Task.Delay(2000);
        IsCopied = false;
        if (ViewingGist != null)
        {
            StateHasChanged();
        }
    }

    private string GetLanguageClass(string? filename)
    {
        if (string.IsNullOrEmpty(filename))
        {
            return "language-plaintext";
        }

        var ext = Path.GetExtension(filename).ToLower().TrimStart('.');
        return ext switch
        {
            "js" => "language-javascript",
            "ts" => "language-typescript",
            "cs" => "language-csharp",
            "py" => "language-python",
            "html" => "language-xml",
            "css" => "language-css",
            "json" => "language-json",
            "md" => "language-markdown",
            "sql" => "language-sql",
            "sh" => "language-bash",
            "yml" or "yaml" => "language-yaml",
            _ => $"language-{ext}"
        };
    }

    private List<string> ParseTags(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return new List<string>();
        }

        var tags = new List<string>();
        var parts = description.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        foreach (var part in parts)
        {
            if (part.StartsWith("#", StringComparison.Ordinal) && part.Length > 1)
            {
                tags.Add(part.Substring(1).TrimEnd(',', '.', '!', '?', ';', ':'));
            }
        }

        return tags;
    }
}
