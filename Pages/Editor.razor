@page "/editor"
@page "/editor/{GistId}"
@using GistHub.Models
@using GistHub.Services
@inject IStorageService Storage
@inject AppState AppState
@inject NavigationManager Navigation
@inject IGithubService Github

<div class="max-w-7xl mx-auto space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-4">
            <button @onclick='() => Navigation.NavigateTo("/my-gists")' class="btn btn-outline btn-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            </button>
            <div>
                <h1 class="text-3xl font-black tracking-tighter">@(string.IsNullOrEmpty(GistId) ? "Create Snippet" : "Edit Snippet")</h1>
                <p class="text-muted-foreground text-sm">Professional editing environment for your cloud gists.</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
             <button @onclick="HandleSave" disabled="@IsLoading" class="btn btn-primary btn-lg">
                @if (IsLoading) { <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div> }
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud-upload"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M12 12v9"/><path d="m16 16-4-4-4 4"/></svg>
                @(string.IsNullOrEmpty(GistId) ? "Publish to GitHub" : "Save Changes")
            </button>
        </div>
    </div>

    <!-- Main Workspace -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Sidebar Settings -->
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-card border rounded-3xl p-6 shadow-sm space-y-6">
                <div class="space-y-2">
                    <label class="text-xs font-black uppercase tracking-widest text-muted-foreground ml-1">Description</label>
                    <textarea @bind="Description" rows="4" placeholder="What does this snippet do? #hashtags supported" class="w-full bg-secondary/30 border rounded-2xl py-3 px-4 focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm resize-none"></textarea>
                </div>

                <div class="space-y-2">
                    <label class="text-xs font-black uppercase tracking-widest text-muted-foreground ml-1">Filename</label>
                    <div class="relative">
                        <input @bind="Filename" type="text" placeholder="script.js" class="w-full bg-secondary/30 border rounded-2xl py-3 px-10 focus:ring-2 focus:ring-primary/20 outline-none transition-all font-mono text-xs" />
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-code absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground"><path d="M10 12.5 8 15l2 2.5"/><path d="m14 12.5 2 2.5-2 2.5"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/></svg>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-xs font-black uppercase tracking-widest text-muted-foreground ml-1">Privacy Level</label>
                    <div class="grid grid-cols-2 gap-2 p-1 bg-secondary/50 rounded-lg border">
                        <button @onclick="() => IsPublic = true" disabled="@(!string.IsNullOrEmpty(GistId))" class="btn btn-sm @(IsPublic ? "btn-secondary bg-background shadow-sm" : "btn-ghost text-muted-foreground") @(!string.IsNullOrEmpty(GistId) ? "cursor-not-allowed opacity-50" : "")">
                            Public
                        </button>
                        <button @onclick="() => IsPublic = false" disabled="@(!string.IsNullOrEmpty(GistId))" class="btn btn-sm @(!IsPublic ? "btn-secondary bg-background shadow-sm" : "btn-ghost text-muted-foreground") @(!string.IsNullOrEmpty(GistId) ? "cursor-not-allowed opacity-50" : "")">
                            Secret
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(GistId))
                    {
                        <p class="text-[10px] text-muted-foreground mt-1 px-1">Note: GitHub doesn't allow changing privacy after creation.</p>
                    }
                </div>
            </div>

            <!-- Helpful Tips -->
            <div class="bg-primary/5 rounded-3xl p-6 border border-primary/10">
                <h4 class="text-xs font-black text-primary uppercase tracking-widest mb-3">Sync Status</h4>
                <div class="flex items-center gap-3">
                    <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                    <span class="text-xs font-bold">Encrypted & Ready</span>
                </div>
            </div>
        </div>

        <!-- Editor Console -->
        <div class="lg:col-span-3 flex flex-col h-[70vh] min-h-[600px]">
            <div class="flex-1 bg-[#0d1117] rounded-[2.5rem] border border-white/5 shadow-2xl relative overflow-hidden group">
                <!-- Editor Header Mockup -->
                <div class="absolute top-0 inset-x-0 h-12 bg-white/5 border-b border-white/5 flex items-center justify-between px-6 z-10 backdrop-blur-sm">
                    <div class="flex gap-1.5">
                        <div class="w-2.5 h-2.5 rounded-full bg-destructive/50"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-amber-500/50"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/50"></div>
                    </div>
                    <div class="flex items-center gap-4">
                        @if (Filename.EndsWith(".md"))
                        {
                            <button @onclick="TogglePreview" class="text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-md transition-all @(IsPreview ? "bg-primary text-primary-foreground" : "bg-white/5 text-zinc-400 hover:bg-white/10")">
                                Preview
                            </button>
                        }
                        <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest font-black">UTF-8 — @Filename</span>
                    </div>
                </div>

                <!-- Main Textarea / Preview -->
                @if (IsPreview && Filename.EndsWith(".md"))
                {
                    <div @ref="previewContainer" class="w-full h-full pt-16 p-8 overflow-auto prose prose-invert max-w-none prose-pre:bg-transparent prose-pre:p-0"></div>
                }
                else
                {
                    <textarea @bind="Content" @bind:event="oninput" spellcheck="false" class="w-full h-full pt-16 p-8 bg-transparent text-zinc-100 font-mono text-sm md:text-base leading-relaxed outline-none resize-none custom-scrollbar" placeholder="// Start writing your masterpiece here..."></textarea>
                }
                
                <!-- Status Bar -->
                <div class="absolute bottom-6 right-8 text-[10px] font-mono text-zinc-500 uppercase tracking-widest bg-zinc-900 px-3 py-1.5 rounded-full border border-white/5">
                    LN @(Content?.Split('\n').Length ?? 1) COL @(Content?.Length ?? 0)
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? GistId { get; set; }
    [Inject] private IJSRuntime JS { get; set; }

    private string Description { get; set; } = "";
    private string Filename { get; set; } = "main.cs";
    private string Content { get; set; } = "";
    private bool IsPublic { get; set; } = true;
    private bool IsLoading { get; set; } = false;
    private bool IsPreview { get; set; } = false;
    private ElementReference previewContainer;
    private bool shouldRenderPreview = false;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!string.IsNullOrEmpty(GistId))
        {
            await LoadGistForEditing();
        }
    }

    private async Task LoadGistForEditing()
    {
        var gists = await Storage.GetLocalGistsAsync();
        var gist = gists.FirstOrDefault(g => g.Id == GistId);
        
        if (gist != null)
        {
            Description = gist.Description;
            var firstFile = gist.Files.FirstOrDefault();
            Filename = firstFile.Key ?? "snippet.txt";
            Content = firstFile.Value?.Content ?? "";
            IsPublic = gist.Public;
        }
    }

    private async Task HandleSave()
    {
        if (string.IsNullOrEmpty(Content)) return;
        
        IsLoading = true;
        StateHasChanged();

        try 
        {
            var files = new Dictionary<string, GistFile>
            {
                { Filename, new GistFile { Content = Content } }
            };

            LocalGist? result;
            if (string.IsNullOrEmpty(GistId))
            {
                result = await Github.CreateGistAsync(Description, IsPublic, files, AppState.CurrentProfile!.AccessToken);
            }
            else 
            {
                result = await Github.UpdateGistAsync(GistId, Description, files, AppState.CurrentProfile!.AccessToken);
            }

            if (result != null)
            {
                result.IsSynced = true;
                result.Tags = ParseTags(Description);
                await Storage.SaveGistAsync(result);
                Navigation.NavigateTo("/my-gists");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving gist: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private List<string> ParseTags(string description)
    {
        if (string.IsNullOrEmpty(description)) return new List<string>();
        var tags = new List<string>();
        var parts = description.Split(' ');
        foreach(var part in parts)
        {
            if (part.StartsWith("#") && part.Length > 1)
                tags.Add(part.Substring(1).TrimEnd(',', '.', '!', '?', ';'));
        }
        return tags;
    }

    private async Task TogglePreview()
    {
        IsPreview = !IsPreview;
        if (IsPreview)
        {
            shouldRenderPreview = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldRenderPreview && previewContainer.Id != null)
        {
            shouldRenderPreview = false;
            await JS.InvokeVoidAsync("renderMarkdown", previewContainer, Content);
        }
    }
}
