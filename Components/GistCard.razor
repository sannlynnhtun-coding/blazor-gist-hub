@using Microsoft.AspNetCore.Components.Web

<div class="group relative bg-card border border-border/50 rounded-2xl overflow-visible hover:shadow-[0_20px_50px_rgba(0,0,0,0.15)] hover:-translate-y-1.5 transition-all duration-500 @(IsSelected ? "ring-2 ring-primary border-primary/50 shadow-lg shadow-primary/5" : "")">
    
    <!-- Active Indicator -->
    <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
    
    <div class="p-5">
        <!-- Header -->
        <div class="flex items-start justify-between mb-4">
            <div class="flex items-center gap-3">
                @if (ShowCheckbox)
                {
                    <div class="relative w-6 h-6 group/check flex-shrink-0">
                        <input type="checkbox" checked="@IsSelected" @onchange="(e) => OnSelectedChanged.InvokeAsync((bool)(e.Value ?? false))" class="absolute inset-0 opacity-0 z-10 cursor-pointer" />
                        <div class="absolute inset-0 rounded-lg border-2 transition-all duration-300 flex items-center justify-center @(IsSelected ? "bg-primary border-primary shadow-lg shadow-primary/20 scale-110" : "bg-muted/50 border-primary/20 group-hover/check:border-primary/50")">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check pointer-events-none opacity-0 @(IsSelected ? "opacity-100 scale-100" : "scale-50") transition-all duration-300"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                    </div>
                }
                <div class="w-10 h-10 rounded-full bg-muted border-2 border-background flex items-center justify-center overflow-hidden ring-1 ring-border group-hover:ring-primary/30 transition-all">
                    <img src="@AvatarUrl" alt="@Author" class="w-full h-full object-cover transition-transform group-hover:scale-110" />
                </div>
                <div class="flex flex-col">
                    <span class="text-sm font-black leading-tight hover:text-primary cursor-pointer transition-colors antialiased">@(string.IsNullOrEmpty(AuthorName) ? Author : AuthorName)</span>
                    <div class="flex flex-col mt-0.5">
                        <span class="text-[11px] text-primary/70 font-bold leading-tight">@@@Author</span>
                        <span class="text-[10px] text-muted-foreground/50 font-bold tabular-nums mt-0.5">@TimeAgo</span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-all translate-x-2 group-hover:translate-x-0">
                @if (OnEdit.HasDelegate)
                {
                    <button @onclick="() => OnEdit.InvokeAsync()" class="p-2 hover:bg-primary/10 text-muted-foreground hover:text-primary rounded-lg transition-colors" title="Edit Gist">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                    </button>
                }
                @if (OnDelete.HasDelegate)
                {
                    <button @onclick="() => OnDelete.InvokeAsync()" class="p-2 hover:bg-destructive/10 text-muted-foreground hover:text-destructive rounded-lg transition-colors" title="Delete Gist">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-2"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                    </button>
                }
                @if (OnClone.HasDelegate)
                {
                    <button @onclick="() => OnClone.InvokeAsync()" class="p-2 hover:bg-primary/10 text-primary rounded-lg transition-colors shadow-sm" title="Clone to my gists">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy-plus"><path d="M12 2H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><polyline points="22 2 15 2 15 9"/><path d="M12 9h9"/><path d="M16.5 13.5v6"/><path d="M13.5 16.5h6"/></svg>
                    </button>
                }
                <button @onclick="() => OnView.InvokeAsync(Id)" class="p-2 hover:bg-secondary text-foreground rounded-lg transition-colors shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                </button>
            </div>
        </div>

        <!-- Content -->
        <div class="space-y-4 cursor-pointer" @onclick="() => OnView.InvokeAsync(Id)">
            <h3 class="text-base font-bold leading-snug line-clamp-2 group-hover:text-primary transition-colors antialiased">@(string.IsNullOrEmpty(Description) ? "Untitled Snippet" : Description)</h3>
            
            <div class="flex flex-wrap gap-1.5">
                @foreach (var tag in Tags)
                {
                    <span class="px-2.5 py-0.5 bg-primary/5 text-primary border border-primary/10 rounded-full text-[10px] font-black uppercase tracking-tight hover:bg-primary hover:text-white transition-all">#@tag</span>
                }
                @if (!Tags.Any())
                {
                    <span class="text-[10px] text-muted-foreground/40 font-bold uppercase tracking-widest italic">No Tags</span>
                }
            </div>

            <!-- Code Preview -->
            <div class="relative bg-zinc-950/50 dark:bg-zinc-900/80 rounded-xl p-4 overflow-hidden border border-border/40 group-hover:border-primary/20 transition-all duration-300">
                <div class="font-mono text-[13px] text-zinc-300 line-clamp-4 leading-relaxed antialiased whitespace-pre">@SnippetPreview</div>
                <div class="absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-zinc-950/80 dark:from-zinc-900 to-transparent pointer-events-none opacity-60 group-hover:opacity-100 transition-opacity"></div>
            </div>
        </div>

        <!-- Footer Info -->
        <div class="mt-5 pt-4 border-t border-border/40 flex items-center justify-between">
            <div class="flex items-center gap-4 text-muted-foreground">
                <div class="flex items-center gap-1.5 group/stat">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star group-hover/stat:fill-yellow-500 group-hover/stat:stroke-yellow-500 transition-all"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <span class="text-xs font-bold font-mono">@Stars</span>
                </div>
                <div class="flex items-center gap-1.5 group/stat">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-git-fork group-hover/stat:stroke-primary transition-all"><path d="m12 12 5-5m-9 0 5 5v7"/><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/></svg>
                    <span class="text-xs font-bold font-mono">@Forks</span>
                </div>
            </div>
            
            <div class="flex items-center gap-2">
                @if (EnableGroupPicker)
                {
                    <div class="relative" @onkeydown="HandlePopoverKeyDown">
                        <button @onclick="ToggleGroupPopover" class="p-1.5 rounded-lg hover:bg-primary/10 text-muted-foreground hover:text-primary transition-colors" title="Manage groups" aria-haspopup="true" aria-expanded="@IsGroupPopoverOpen">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-plus"><path d="M12 10v6"/><path d="M9 13h6"/><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.7-.9l-.8-1.2A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
                        </button>

                        @if (IsGroupPopoverOpen)
                        {
                            <button class="fixed inset-0 z-40 cursor-default" aria-label="Close group selector" @onclick="CloseGroupPopover"></button>
                            <div class="absolute right-0 bottom-10 z-50 w-72 rounded-xl border bg-card shadow-2xl p-3 space-y-3" tabindex="0" @ref="PopoverRef" @onclick:stopPropagation="true" @onkeydown="HandlePopoverKeyDown">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-black uppercase tracking-widest text-muted-foreground">Groups</span>
                                    <span class="text-[10px] font-bold text-primary">@SelectedGroups.Count selected</span>
                                </div>

                                <div class="max-h-44 overflow-auto space-y-1 pr-1">
                                    @if (!AvailableGroups.Any())
                                    {
                                        <p class="text-xs text-muted-foreground">No groups yet. Create one below.</p>
                                    }
                                    else
                                    {
                                        @foreach (var groupName in AvailableGroups)
                                        {
                                            <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-muted/50 cursor-pointer">
                                                <input type="checkbox"
                                                       checked="@IsGroupSelected(groupName)"
                                                       @onchange="(e) => ToggleGroupMembership(groupName, (bool)(e.Value ?? false))"
                                                       class="rounded border-border" />
                                                <span class="text-xs font-semibold truncate">@groupName</span>
                                            </label>
                                        }
                                    }
                                </div>

                                <div class="pt-2 border-t border-border/40 space-y-2">
                                    <div class="flex items-center gap-2">
                                        <input type="text"
                                               @bind="NewGroupName"
                                               @bind:event="oninput"
                                               @onkeydown="HandleNewGroupKeyDown"
                                               placeholder="Create new group"
                                               class="w-full h-8 px-2 rounded-lg border bg-background text-xs" />
                                        <button @onclick="CreateGroupFromPopover" class="px-2 py-1 rounded-md bg-primary text-primary-foreground text-xs font-bold">Add</button>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(GroupValidationMessage))
                                    {
                                        <p class="text-[10px] text-destructive font-medium">@GroupValidationMessage</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <button @onclick="() => OnToggleBookmark.InvokeAsync(Id)" class="p-1.5 rounded-lg hover:bg-yellow-500/10 @(IsBookmarked ? "text-yellow-500" : "text-muted-foreground") transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="@(IsBookmarked ? "currentColor" : "none")" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bookmark"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
                </button>
                <div class="h-4 w-[1px] bg-border mx-1"></div>
                <div class="text-[10px] text-muted-foreground font-black uppercase tracking-widest opacity-40 group-hover:opacity-100 group-hover:text-primary transition-all cursor-pointer" @onclick="() => OnView.InvokeAsync(Id)">Open Details</div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string AvatarUrl { get; set; } = "https://github.com/identicons/slh.png";
    [Parameter] public string Author { get; set; } = "anonymous";
    [Parameter] public string AuthorName { get; set; } = "";
    [Parameter] public string TimeAgo { get; set; } = "just now";
    [Parameter] public string Description { get; set; } = "No description provided.";
    [Parameter] public List<string> Tags { get; set; } = new();
    [Parameter] public string SnippetPreview { get; set; } = "";
    [Parameter] public int Stars { get; set; } = 0;
    [Parameter] public int Forks { get; set; } = 0;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback<bool> OnSelectedChanged { get; set; }
    [Parameter] public bool ShowCheckbox { get; set; } = false;
    [Parameter] public bool IsBookmarked { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnClone { get; set; }
    [Parameter] public EventCallback<string> OnView { get; set; }
    [Parameter] public EventCallback<string> OnToggleBookmark { get; set; }

    [Parameter] public bool EnableGroupPicker { get; set; }
    [Parameter] public List<string> AvailableGroups { get; set; } = new();
    [Parameter] public List<string> SelectedGroups { get; set; } = new();
    [Parameter] public EventCallback<string> OnToggleGroupOn { get; set; }
    [Parameter] public EventCallback<string> OnToggleGroupOff { get; set; }
    [Parameter] public EventCallback<string> OnCreateGroup { get; set; }

    private bool IsGroupPopoverOpen { get; set; }
    private string NewGroupName { get; set; } = "";
    private string GroupValidationMessage { get; set; } = "";
    private ElementReference PopoverRef;
    private bool FocusPopoverPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusPopoverPending)
        {
            FocusPopoverPending = false;
            await PopoverRef.FocusAsync();
        }
    }

    private bool IsGroupSelected(string groupName)
        => SelectedGroups.Any(name => string.Equals(name, groupName, StringComparison.OrdinalIgnoreCase));

    private void ToggleGroupPopover()
    {
        IsGroupPopoverOpen = !IsGroupPopoverOpen;
        GroupValidationMessage = "";
        if (IsGroupPopoverOpen)
        {
            FocusPopoverPending = true;
        }
    }

    private void CloseGroupPopover()
    {
        IsGroupPopoverOpen = false;
        GroupValidationMessage = "";
    }

    private async Task ToggleGroupMembership(string groupName, bool isEnabled)
    {
        if (isEnabled)
        {
            await OnToggleGroupOn.InvokeAsync(groupName);
        }
        else
        {
            await OnToggleGroupOff.InvokeAsync(groupName);
        }
    }

    private async Task CreateGroupFromPopover()
    {
        GroupValidationMessage = "";
        var normalized = (NewGroupName ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(normalized))
        {
            GroupValidationMessage = "Group name is required.";
            return;
        }

        if (AvailableGroups.Any(name => string.Equals(name, normalized, StringComparison.OrdinalIgnoreCase)))
        {
            GroupValidationMessage = "Group name already exists.";
            return;
        }

        await OnCreateGroup.InvokeAsync(normalized);
        NewGroupName = "";
        await OnToggleGroupOn.InvokeAsync(normalized);
    }

    private async Task HandleNewGroupKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await CreateGroupFromPopover();
        }
        else if (args.Key == "Escape")
        {
            CloseGroupPopover();
        }
    }

    private void HandlePopoverKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseGroupPopover();
        }
    }
}
