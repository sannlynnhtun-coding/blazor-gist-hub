@if (IsOpen)
{
    <section class="json-parser-overlay" role="dialog" aria-modal="true" aria-labelledby="json-parser-title" @onkeydown="HandleKeyDown">
        <header class="json-parser-header">
            <div class="json-parser-title-group">
                <div class="json-parser-mark" aria-hidden="true">{ }</div>
                <div>
                    <div class="neo-kicker">Escape hatch</div>
                    <h1 id="json-parser-title">JSON Parser</h1>
                </div>
            </div>

            <div class="json-parser-pipeline" aria-label="Parsing steps">
                <span>Raw string</span>
                <svg viewBox="0 0 48 12" aria-hidden="true"><path d="M1 6h42m-6-5 6 5-6 5" /></svg>
                <span>Deserialize</span>
                <svg viewBox="0 0 48 12" aria-hidden="true"><path d="M1 6h42m-6-5 6 5-6 5" /></svg>
                <span>JSON object</span>
            </div>

            <button class="json-parser-close" type="button" @onclick="CloseAsync" aria-label="Close JSON parser" title="Close JSON parser (Esc)">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <path d="M18 6 6 18" />
                    <path d="m6 6 12 12" />
                </svg>
            </button>
        </header>

        <div class="json-parser-workspace">
            <section class="json-parser-pane json-parser-pane--input" aria-labelledby="json-input-heading">
                <div class="json-parser-pane-header">
                    <div>
                        <span class="json-parser-step">01 · Input</span>
                        <h2 id="json-input-heading">Paste escaped JSON</h2>
                    </div>
                    <div class="json-parser-actions">
                        <button type="button" class="json-parser-text-button" @onclick="UseExample">Use example</button>
                        <button type="button" class="json-parser-text-button" @onclick="Clear" disabled="@string.IsNullOrEmpty(InputText)">Clear</button>
                    </div>
                </div>

                <div class="json-parser-editor-wrap">
                    <textarea
                        @ref="InputElement"
                        class="json-parser-input custom-scrollbar"
                        value="@InputText"
                        @oninput="HandleInput"
                        spellcheck="false"
                        autocomplete="off"
                        autocapitalize="off"
                        aria-describedby="json-input-hint"
                        placeholder="Paste standard JSON or a quoted, escaped JSON string..."></textarea>
                    <span class="json-parser-corner-label">RAW</span>
                </div>

                <div class="json-parser-pane-footer">
                    <span id="json-input-hint">Outer quotes are optional. Escaped inner quotes are decoded automatically.</span>
                    <button type="button" class="btn btn-primary btn-md" @onclick="ParseInput" disabled="@string.IsNullOrWhiteSpace(InputText)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m8 9-3 3 3 3" /><path d="m16 9 3 3-3 3" /><path d="m14 5-4 14" />
                        </svg>
                        Parse JSON
                    </button>
                </div>
            </section>

            <div class="json-parser-transfer" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
            </div>

            <section class="json-parser-pane json-parser-pane--output" aria-labelledby="json-output-heading">
                <div class="json-parser-pane-header">
                    <div>
                        <span class="json-parser-step">02 · Result</span>
                        <h2 id="json-output-heading">Deserialized object</h2>
                    </div>
                    <div class="json-parser-output-controls">
                        <div class="json-parser-mode-toggle" role="group" aria-label="JSON output style">
                            <button type="button"
                                    aria-pressed="@(WriteIndented ? "true" : "false")"
                                    @onclick="() => SetOutputMode(true)"
                                    title="Show indented JSON">
                                Format
                            </button>
                            <button type="button"
                                    aria-pressed="@(!WriteIndented ? "true" : "false")"
                                    @onclick="() => SetOutputMode(false)"
                                    title="Show JSON on one line">
                                Compress
                            </button>
                        </div>
                        @if (ParseResult.Success)
                        {
                            <span class="json-parser-valid-badge">
                                <span aria-hidden="true"></span>
                                Valid JSON
                            </span>
                        }
                    </div>
                </div>

                @if (ParseResult.Success)
                {
                    <div class="json-parser-type-legend" aria-label="JSON syntax color legend">
                        <span><i class="json-token-field" aria-hidden="true"></i>Field</span>
                        <span><i class="json-token-string" aria-hidden="true"></i>String</span>
                        <span><i class="json-token-number" aria-hidden="true"></i>Number</span>
                        <span><i class="json-token-boolean" aria-hidden="true"></i>Boolean</span>
                        <span><i class="json-token-null" aria-hidden="true"></i>Null</span>
                    </div>
                }

                <div class="json-parser-result-wrap" aria-live="polite">
                    @if (ParseResult.Success)
                    {
                        <pre class="json-parser-result custom-scrollbar"><code>@HighlightedOutput</code></pre>
                        <span class="json-parser-corner-label json-parser-corner-label--result">@(WriteIndented ? "FORMATTED" : "COMPRESSED")</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(InputText))
                    {
                        <div class="json-parser-message json-parser-message--error" role="alert">
                            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" /><path d="M12 8v4" /><path d="M12 16h.01" />
                            </svg>
                            <div>
                                <strong>Couldn’t parse this value</strong>
                                <span>@ParseResult.Message</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="json-parser-message">
                            <div class="json-parser-empty-mark" aria-hidden="true">{ }</div>
                            <div>
                                <strong>Your object appears here</strong>
                                <span>Paste JSON on the left or load the example to begin.</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="json-parser-pane-footer json-parser-pane-footer--output">
                    <span>@(ParseResult.Success ? $"{ParseResult.Summary} · {(WriteIndented ? "Indented" : "Compressed")}" : "Waiting for valid JSON")</span>
                    <button type="button" class="btn btn-secondary btn-md" @onclick="CopyResultAsync" disabled="@(!ParseResult.Success)">
                        @if (IsCopied)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5" /></svg>
                            <span>Copied</span>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
                            <span>Copy result</span>
                        }
                    </button>
                </div>
            </section>
        </div>
    </section>
}

@inject IJSRuntime JS

@code {
    private const string ExampleInput = "\"{\\\"Yescutility\\\":null,\\\"TranId\\\":null,\\\"AccountNo\\\":null,\\\"RespCode\\\":\\\"E0004\\\",\\\"RespDescription\\\":\\\"Wallet account doesn't exist for this user\\\"}\"";

    private ElementReference InputElement;
    private string InputText { get; set; } = string.Empty;
    private JsonNormalizationResult ParseResult { get; set; } = JsonTextNormalizer.Normalize(null);
    private bool WriteIndented { get; set; } = true;
    private bool IsCopied { get; set; }
    private bool ShouldFocusInput { get; set; }
    private bool WasOpen { get; set; }

    private MarkupString HighlightedOutput
        => new(JsonSyntaxHighlighter.Highlight(ParseResult.Output));

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override void OnParametersSet()
    {
        if (IsOpen && !WasOpen)
        {
            ShouldFocusInput = true;
        }

        WasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShouldFocusInput)
        {
            ShouldFocusInput = false;
            await InputElement.FocusAsync();
        }
    }

    private void HandleInput(ChangeEventArgs args)
    {
        InputText = args.Value?.ToString() ?? string.Empty;
        ParseInput();
    }

    private void ParseInput()
    {
        ParseResult = JsonTextNormalizer.Normalize(InputText, WriteIndented);
        IsCopied = false;
    }

    private void SetOutputMode(bool writeIndented)
    {
        if (WriteIndented == writeIndented)
        {
            return;
        }

        WriteIndented = writeIndented;
        ParseInput();
    }

    private void UseExample()
    {
        InputText = ExampleInput;
        ParseInput();
    }

    private void Clear()
    {
        InputText = string.Empty;
        ParseInput();
        _ = InputElement.FocusAsync();
    }

    private async Task CopyResultAsync()
    {
        if (!ParseResult.Success)
        {
            return;
        }

        await JS.InvokeVoidAsync("copyToClipboard", ParseResult.Output);
        IsCopied = true;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
