@if (IsOpen)
{
    <section class="code-image-overlay" role="dialog" aria-modal="true" aria-labelledby="code-image-title" @onkeydown="HandleKeyDown">
        <header class="code-image-header">
            <div class="code-image-title-group">
                <div class="code-image-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m8 9-3 3 3 3"/><path d="m16 9 3 3-3 3"/><path d="m14 5-4 14"/></svg>
                </div>
                <div>
                    <div class="neo-kicker">Share-ready snippets</div>
                    <h1 id="code-image-title">Code to Image</h1>
                </div>
            </div>

            <div class="code-image-pipeline" aria-label="Export steps">
                <span>Paste code</span>
                <svg viewBox="0 0 48 12" aria-hidden="true"><path d="M1 6h42m-6-5 6 5-6 5" /></svg>
                <span>Style it</span>
                <svg viewBox="0 0 48 12" aria-hidden="true"><path d="M1 6h42m-6-5 6 5-6 5" /></svg>
                <span>Export PNG</span>
            </div>

            <button class="code-image-close" type="button" @onclick="CloseAsync" aria-label="Close code to image" title="Close code to image (Esc)">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
            </button>
        </header>

        <div class="code-image-workspace">
            <aside class="code-image-controls custom-scrollbar" aria-label="Image settings">
                <div class="code-image-section-heading">
                    <span class="code-image-step">01 · Compose</span>
                    <h2>Shape the shot</h2>
                    <p>Your code stays in this browser.</p>
                </div>

                <div class="code-image-field-grid">
                    <label class="code-image-field">
                        <span>Language</span>
                        <select value="@SelectedLanguage" @onchange="HandleLanguageChanged">
                            @foreach (var language in Languages)
                            {
                                <option value="@language.Value">@language.Label</option>
                            }
                        </select>
                    </label>

                    <label class="code-image-switch">
                        <span>
                            <strong>Line numbers</strong>
                            <small>Keep context visible</small>
                        </span>
                        <input type="checkbox" checked="@ShowLineNumbers" @onchange="HandleLineNumbersChanged" />
                        <i aria-hidden="true"></i>
                    </label>
                </div>

                <label class="code-image-field">
                    <span>Title</span>
                    <input value="@Title" @oninput="HandleTitleInput" placeholder="Snippet title" maxlength="80" />
                </label>

                <label class="code-image-field">
                    <span>Author</span>
                    <input value="@Author" @oninput="HandleAuthorInput" placeholder="Your name or handle" maxlength="60" />
                </label>

                <fieldset class="code-image-choice-group">
                    <legend>Theme</legend>
                    <div class="code-image-theme-grid">
                        @foreach (var theme in ThemePresets)
                        {
                            <button type="button"
                                    class="code-image-theme @(SelectedTheme == theme.Value ? "is-selected" : null)"
                                    aria-pressed="@(SelectedTheme == theme.Value ? "true" : "false")"
                                    @onclick="() => SelectTheme(theme.Value)">
                                <span style="@($"--swatch-bg:{theme.Background};--swatch-glow:{theme.Glow};--swatch-accent:{theme.Accent}")" aria-hidden="true"><i></i></span>
                                @theme.Label
                            </button>
                        }
                    </div>
                </fieldset>

                <fieldset class="code-image-choice-group">
                    <legend>Canvas</legend>
                    <div class="code-image-format-grid">
                        @foreach (var format in Formats)
                        {
                            <button type="button"
                                    aria-pressed="@(SelectedFormat == format.Value ? "true" : "false")"
                                    @onclick="() => SelectFormat(format.Value)">
                                <i class="code-image-format-icon code-image-format-icon--@format.Value" aria-hidden="true"></i>
                                <span>@format.Label</span>
                            </button>
                        }
                    </div>
                </fieldset>

                <label class="code-image-range">
                    <span><strong>Type size</strong><output>@FontSize px</output></span>
                    <input type="range" min="14" max="26" step="1" value="@FontSize" @oninput="HandleFontSizeChanged" />
                </label>

                <label class="code-image-range">
                    <span><strong>Canvas padding</strong><output>@CanvasPadding px</output></span>
                    <input type="range" min="32" max="96" step="8" value="@CanvasPadding" @oninput="HandlePaddingChanged" />
                </label>
            </aside>

            <main class="code-image-stage">
                <div class="code-image-stage-heading">
                    <div>
                        <span class="code-image-step">02 · Preview</span>
                        <h2>Ready for the feed</h2>
                    </div>
                    <span class="code-image-live-badge"><i aria-hidden="true"></i>Live preview</span>
                </div>

                <div class="code-image-preview-shell custom-scrollbar">
                    <div class="code-image-preview-frame code-image-preview-frame--@SelectedFormat" style="@PreviewStyle">
                        <div class="code-image-orbit code-image-orbit--one" aria-hidden="true"></div>
                        <div class="code-image-orbit code-image-orbit--two" aria-hidden="true"></div>

                        <article class="code-image-card">
                            <div class="code-image-card-bar">
                                <div class="code-image-dots" aria-hidden="true"><i></i><i></i><i></i></div>
                                <span>@LanguageLabel</span>
                            </div>
                            <div class="code-image-card-meta">
                                <div>
                                    <h3>@DisplayTitle</h3>
                                    <p>@DisplayAuthor</p>
                                </div>
                                <span>@LineCount.ToString("00") lines</span>
                            </div>
                            <div class="code-image-code-grid @(ShowLineNumbers ? "has-line-numbers" : null)" style="@($"--preview-font-size:{FontSize}px")">
                                @if (ShowLineNumbers)
                                {
                                    <pre class="code-image-line-numbers" aria-hidden="true">@LineNumberText</pre>
                                }
                                <pre class="code-image-preview-code custom-scrollbar"><code @ref="PreviewCodeElement"></code></pre>
                            </div>
                        </article>

                        <div class="code-image-signature">
                            <span>GISTHUB / CODE CAPTURE</span>
                            <span>@SelectedFormat.ToUpperInvariant()</span>
                        </div>
                    </div>
                </div>

                <div class="code-image-export-bar">
                    <div>
                        <strong>Export locally</strong>
                        <span class="@(ClipboardCopyFailed ? "is-error" : ImageCopied ? "is-success" : null)" role="status" aria-live="polite">@ExportStatus</span>
                    </div>
                    <div class="code-image-export-actions">
                        <button type="button" class="btn btn-secondary btn-md" @onclick="CopySettingsAsync">
                            @if (SettingsCopied)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m20 6-11 11-5-5" /></svg>
                                <span>Copied</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
                                <span>Copy settings</span>
                            }
                        </button>
                        <button type="button"
                                class="code-image-copy-button btn btn-secondary btn-md @(ImageCopied ? "is-success" : ClipboardCopyFailed ? "is-error" : null)"
                                @onclick="CopyImageAsync"
                                disabled="@IsCopyingImage"
                                title="Copy image to clipboard">
                            @if (IsCopyingImage)
                            {
                                <span class="code-image-spinner" aria-hidden="true"></span>
                                <span>Copying…</span>
                            }
                            else if (ImageCopied)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m20 6-11 11-5-5" /></svg>
                                <span>Image copied</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" /></svg>
                                <span>Copy image</span>
                            }
                        </button>
                        <button type="button" class="code-image-download-button btn btn-primary btn-md" @onclick="DownloadAsync" disabled="@IsExporting">
                            @if (IsExporting)
                            {
                                <span class="code-image-spinner" aria-hidden="true"></span>
                                <span>Rendering…</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
                                <span>Download PNG</span>
                            }
                        </button>
                    </div>
                </div>
            </main>

            <section class="code-image-editor-pane" aria-labelledby="code-image-editor-title">
                <div class="code-image-editor-heading">
                    <div>
                        <span class="code-image-step">Source</span>
                        <h2 id="code-image-editor-title">Code</h2>
                    </div>
                    <div>
                        <button type="button" class="json-parser-text-button" @onclick="UseExample">Example</button>
                        <button type="button" class="json-parser-text-button" @onclick="ClearCode" disabled="@string.IsNullOrEmpty(Code)">Clear</button>
                    </div>
                </div>
                <textarea @ref="CodeInputElement"
                          class="code-image-editor custom-scrollbar"
                          value="@Code"
                          @oninput="HandleCodeInput"
                          spellcheck="false"
                          autocomplete="off"
                          autocapitalize="off"
                          aria-label="Code to export"
                          placeholder="Paste code here…"></textarea>
                <div class="code-image-editor-footer">
                    <span>@LineCount lines · @Code.Length characters</span>
                    <span>@LanguageLabel</span>
                </div>
            </section>
        </div>
    </section>
}

@inject IJSRuntime JS

@code {
    private const string ExampleCode = "public record Gist(string Id, string Description);\n\npublic static string BuildShareUrl(Gist gist)\n{\n    ArgumentNullException.ThrowIfNull(gist);\n    return $\"https://gist.github.com/{gist.Id}\";\n}";

    private static readonly (string Value, string Label)[] Languages =
    [
        ("auto", "Auto detect"), ("csharp", "C#"), ("javascript", "JavaScript"),
        ("typescript", "TypeScript"), ("python", "Python"), ("java", "Java"),
        ("cpp", "C++"), ("go", "Go"), ("rust", "Rust"), ("php", "PHP"),
        ("ruby", "Ruby"), ("kotlin", "Kotlin"), ("swift", "Swift"),
        ("xml", "HTML / XML"), ("css", "CSS"), ("scss", "SCSS"),
        ("json", "JSON"), ("yaml", "YAML"), ("sql", "SQL"),
        ("bash", "Bash"), ("plaintext", "Plain text")
    ];

    private static readonly (string Value, string Label)[] Formats =
    [
        ("auto", "Auto"), ("square", "1:1"), ("landscape", "16:9"), ("portrait", "4:5")
    ];

    private static readonly ThemePreset[] ThemePresets =
    [
        new("midnight", "Midnight", "#0d1022", "#6845ff", "#78dce8", "#121426", "#f7f3e8", "#aaa7bf"),
        new("signal", "Signal", "#101410", "#2f773c", "#71d84b", "#111811", "#efffe9", "#91a68f"),
        new("paper", "Paper", "#fff0cf", "#ff9f5a", "#ff4f87", "#fffaf0", "#17130f", "#6d6257"),
        new("grape", "Grape", "#241231", "#b13d8c", "#ff7cb8", "#1c1027", "#fff4fa", "#c3a8bd")
    ];

    private ElementReference CodeInputElement;
    private ElementReference PreviewCodeElement;
    private string Code { get; set; } = ExampleCode;
    private string SelectedLanguage { get; set; } = "csharp";
    private string SelectedTheme { get; set; } = "midnight";
    private string SelectedFormat { get; set; } = "auto";
    private string Title { get; set; } = "A tiny share-link helper";
    private string Author { get; set; } = "@gisthub";
    private bool ShowLineNumbers { get; set; } = true;
    private int FontSize { get; set; } = 18;
    private int CanvasPadding { get; set; } = 64;
    private bool IsExporting { get; set; }
    private bool IsCopyingImage { get; set; }
    private bool ImageCopied { get; set; }
    private bool ClipboardCopyFailed { get; set; }
    private bool SettingsCopied { get; set; }
    private bool ShouldFocusInput { get; set; }
    private bool ShouldRefreshPreview { get; set; }
    private bool WasOpen { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ThemePreset ActiveTheme => ThemePresets.First(theme => theme.Value == SelectedTheme);
    private int LineCount => string.IsNullOrEmpty(Code) ? 1 : Code.Replace("\r\n", "\n").Split('\n').Length;
    private string LineNumberText => string.Join('\n', Enumerable.Range(1, LineCount));
    private string DisplayTitle => string.IsNullOrWhiteSpace(Title) ? "Untitled snippet" : Title.Trim();
    private string DisplayAuthor => string.IsNullOrWhiteSpace(Author) ? "Anonymous maker" : Author.Trim();
    private string LanguageLabel => Languages.First(language => language.Value == SelectedLanguage).Label;
    private string PreviewStyle => $"--capture-bg:{ActiveTheme.Background};--capture-glow:{ActiveTheme.Glow};--capture-accent:{ActiveTheme.Accent};--capture-card:{ActiveTheme.Card};--capture-text:{ActiveTheme.Text};--capture-muted:{ActiveTheme.Muted};--capture-padding:{CanvasPadding}px";
    private string ExportStatus => ClipboardCopyFailed
        ? "Clipboard image access is unavailable — download still works"
        : ImageCopied
            ? "PNG copied to your clipboard"
            : "High-resolution PNG · no upload";

    protected override void OnParametersSet()
    {
        if (IsOpen && !WasOpen)
        {
            ShouldFocusInput = true;
            ShouldRefreshPreview = true;
        }

        WasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShouldFocusInput)
        {
            ShouldFocusInput = false;
            await CodeInputElement.FocusAsync();
        }

        if (ShouldRefreshPreview && IsOpen)
        {
            ShouldRefreshPreview = false;
            await JS.InvokeVoidAsync("renderCodeImagePreview", PreviewCodeElement, Code, SelectedLanguage);
        }
    }

    private void HandleCodeInput(ChangeEventArgs args)
    {
        Code = args.Value?.ToString() ?? string.Empty;
        ResetCopyFeedback();
        RefreshPreview();
    }

    private void HandleLanguageChanged(ChangeEventArgs args)
    {
        SelectedLanguage = args.Value?.ToString() ?? "auto";
        ResetCopyFeedback();
        RefreshPreview();
    }

    private void HandleLineNumbersChanged(ChangeEventArgs args)
    {
        ShowLineNumbers = args.Value is bool enabled && enabled;
        ResetCopyFeedback();
    }

    private void HandleTitleInput(ChangeEventArgs args)
    {
        Title = args.Value?.ToString() ?? string.Empty;
        ResetCopyFeedback();
    }

    private void HandleAuthorInput(ChangeEventArgs args)
    {
        Author = args.Value?.ToString() ?? string.Empty;
        ResetCopyFeedback();
    }

    private void HandleFontSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value)) FontSize = value;
        ResetCopyFeedback();
    }

    private void HandlePaddingChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value)) CanvasPadding = value;
        ResetCopyFeedback();
    }

    private void SelectTheme(string theme)
    {
        SelectedTheme = theme;
        ResetCopyFeedback();
    }

    private void SelectFormat(string format)
    {
        SelectedFormat = format;
        ResetCopyFeedback();
    }

    private void UseExample()
    {
        Code = ExampleCode;
        SelectedLanguage = "csharp";
        RefreshPreview();
    }

    private void ClearCode()
    {
        Code = string.Empty;
        RefreshPreview();
        _ = CodeInputElement.FocusAsync();
    }

    private void RefreshPreview()
    {
        ShouldRefreshPreview = true;
        ResetCopyFeedback();
    }

    private void ResetCopyFeedback()
    {
        SettingsCopied = false;
        ImageCopied = false;
        ClipboardCopyFailed = false;
    }

    private async Task CopySettingsAsync()
    {
        var settings = System.Text.Json.JsonSerializer.Serialize(new
        {
            language = SelectedLanguage,
            theme = SelectedTheme,
            format = SelectedFormat,
            title = DisplayTitle,
            author = DisplayAuthor,
            lineNumbers = ShowLineNumbers,
            fontSize = FontSize,
            padding = CanvasPadding
        }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

        await JS.InvokeVoidAsync("copyToClipboard", settings);
        SettingsCopied = true;
    }

    private async Task CopyImageAsync()
    {
        if (IsCopyingImage) return;

        IsCopyingImage = true;
        ImageCopied = false;
        ClipboardCopyFailed = false;

        try
        {
            ImageCopied = await JS.InvokeAsync<bool>("copyCodeImageToClipboard", CreateExportOptions());
            ClipboardCopyFailed = !ImageCopied;
        }
        catch (JSException)
        {
            ClipboardCopyFailed = true;
        }
        finally
        {
            IsCopyingImage = false;
        }
    }

    private async Task DownloadAsync()
    {
        if (IsExporting) return;

        IsExporting = true;
        try
        {
            await JS.InvokeVoidAsync("downloadCodeImage", CreateExportOptions());
        }
        finally
        {
            IsExporting = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await CloseAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private object CreateExportOptions() => new
    {
        code = Code,
        language = SelectedLanguage,
        languageLabel = LanguageLabel,
        theme = SelectedTheme,
        format = SelectedFormat,
        title = DisplayTitle,
        author = DisplayAuthor,
        showLineNumbers = ShowLineNumbers,
        fontSize = FontSize,
        padding = CanvasPadding
    };

    private sealed record ThemePreset(
        string Value,
        string Label,
        string Background,
        string Glow,
        string Accent,
        string Card,
        string Text,
        string Muted);
}
