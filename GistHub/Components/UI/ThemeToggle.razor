@inject IJSRuntime JS

<button @onclick="ToggleTheme" class="relative inline-flex items-center justify-center p-2 rounded-md bg-card border border-border hover:bg-secondary transition-all group overflow-hidden" title="Toggle Theme">
    <div class="relative w-6 h-6">
        <!-- Sun Icon -->
        <div class="absolute inset-0 transform transition-all duration-500 @(IsDark ? "rotate-90 scale-0 opacity-0" : "rotate-0 scale-100 opacity-100")">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun text-[#956400]"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        </div>
        <!-- Moon Icon -->
        <div class="absolute inset-0 transform transition-all duration-500 @(IsDark ? "rotate-0 scale-100 opacity-100" : "-rotate-90 scale-0 opacity-0")">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon text-muted-foreground"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </div>
    </div>
</button>

@code {
    private bool IsDark { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("localStorage.getItem", "theme");
            IsDark = theme == "dark";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        IsDark = !IsDark;
        if (IsDark)
        {
            await JS.InvokeVoidAsync("document.documentElement.classList.add", "dark");
            await JS.InvokeVoidAsync("localStorage.setItem", "theme", "dark");
        }
        else
        {
            await JS.InvokeVoidAsync("document.documentElement.classList.remove", "dark");
            await JS.InvokeVoidAsync("localStorage.setItem", "theme", "light");
        }
    }
}
