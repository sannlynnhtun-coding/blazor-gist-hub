@inject IJSRuntime JS

<select class="neo-theme-select bg-card text-foreground border border-border rounded-md text-sm font-bold" aria-label="Page theme" title="Choose page theme" value="@Theme" @oninput="ChangeTheme" @onchange="ChangeTheme">
    <optgroup label="GistHub">
    <option value="light">☀ Light</option>
    <option value="dark">☾ Dark</option>
    <option value="ocean">◈ Ocean</option>
    <option value="forest">❋ Forest</option>
    <option value="rose">✿ Rose</option>
    </optgroup>
    <optgroup label="Highlight.js">
        @foreach (var palette in HighlightThemes)
        {
            <option value="@palette.Id">@palette.Name</option>
        }
    </optgroup>
</select>

@code {
    private ThemeOption[] HighlightThemes = [];
    private sealed record ThemeOption(string Id, string Name);
    private string Theme = "light";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            HighlightThemes = await JS.InvokeAsync<ThemeOption[]>("getGistHubThemes");
            Theme = await JS.InvokeAsync<string>("getGistHubTheme");
            StateHasChanged();
        }
    }

    private async Task ChangeTheme(ChangeEventArgs args)
    {
        var selected = args.Value?.ToString() ?? "light";
        if (selected == Theme) return;
        Theme = selected;
        await JS.InvokeVoidAsync("applyGistHubTheme", Theme);
    }
}
