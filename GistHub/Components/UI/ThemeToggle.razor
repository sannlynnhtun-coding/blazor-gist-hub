@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="neo-theme-picker" @ref="Picker" data-saved-theme="@Theme">
    <button class="neo-theme-trigger" type="button" popovertarget="@PanelId" aria-label="Page theme" aria-haspopup="dialog" title="Preview and choose a page theme">
        <span class="neo-theme-trigger__swatch" aria-hidden="true"></span>
        <span class="neo-theme-trigger__name">@SelectedName</span>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6" /></svg>
    </button>
    <div id="@PanelId" popover="auto" class="neo-theme-panel" role="dialog" aria-label="Choose a theme">
        <header class="neo-theme-panel__header">
            <div><span class="neo-theme-panel__eyebrow">Make it yours</span><h2>Choose your appearance</h2></div>
            <span class="neo-theme-panel__badge">LIVE</span>
        </header>
        <div class="neo-style-control">
            <label for="@StyleId">Common Visual Styles</label>
            <select id="@StyleId" value="@Style" @onchange="ChangeStyle" aria-describedby="@StyleHintId">
                @foreach (var group in Styles.GroupBy(style => style.Group))
                {
                    <optgroup label="@group.Key">
                        @foreach (var style in group)
                        {
                            <option value="@style.Id">@style.Name</option>
                        }
                    </optgroup>
                }
            </select>
            <p id="@StyleHintId">@StyleDescription &middot; Keeps your selected color theme. Changes are saved instantly.</p>
            <button type="button" class="neo-style-reset" @onclick="RestoreStyle">Restore default style</button>
        </div>
        <div class="neo-style-control">
            <label for="@PresetId">Style + Theme presets</label>
            <select id="@PresetId" value="@SelectedPreset" @onchange="ChangePreset" aria-describedby="@PresetHintId">
                <option value="">Choose a style and theme combination</option>
                @foreach (var preset in Presets)
                {
                    <option value="@preset.Id">@preset.Name</option>
                }
            </select>
            <p id="@PresetHintId">Applies and saves both the visual style and color theme.</p>
        </div>
        <div class="neo-theme-panel__search">
            <span class="neo-palette-label">Color themes</span>
            <input type="search" aria-label="Search themes" placeholder="Find a theme…" autocomplete="off" autofocus aria-describedby="@HintId" />
        </div>
        <div class="neo-theme-options custom-scrollbar" role="listbox" aria-label="Available themes">
            @foreach (var palette in Palettes)
            {
                <button @key="palette.Id" type="button" role="option" tabindex="-1" aria-selected="@(Theme == palette.Id ? "true" : "false")"
                        class="neo-theme-option" data-theme-option="@palette.Id" data-theme-name="@palette.Name" @onclick="() => SelectTheme(palette.Id)">
                    <span class="neo-theme-option__colors" aria-hidden="true"><i style="background:@palette.Chrome"></i><i style="background:@palette.Primary"></i><i style="background:@palette.Secondary"></i></span>
                    <span class="neo-theme-option__name">@palette.Name<span class="neo-theme-option__source">@palette.Source</span></span>
                    <svg class="neo-theme-option__check" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12 4 4L19 6" /></svg>
                </button>
            }
        </div>
        <p class="neo-theme-panel__empty" hidden>No themes found. Try another name.</p>
        <footer class="neo-theme-panel__footer">
            <button type="button" class="neo-theme-restore" @onclick="RestoreDefault">Restore default</button>
            <div id="@HintId">Hover or use ↑ ↓ to preview. Click or Enter to save.<span>Esc to cancel · <a href="https://vscodethemes.com/" target="_blank" rel="noopener noreferrer">VS Code Themes</a></span></div>
        </footer>
    </div>
</div>

@code {
    private ElementReference Picker;
    private string PresetId => $"{PanelId}-preset";
    private string PresetHintId => $"{PanelId}-preset-hint";
    private List<StylePreset> Presets = [];
    private sealed record StylePreset(string Id, string Name, string Style, string Theme);
    private string SelectedPreset => Presets.FirstOrDefault(p => p.Style == Style && p.Theme == Theme)?.Id ?? "";

    private async Task ChangePreset(ChangeEventArgs e)
    {
        var preset = await JS.InvokeAsync<StylePreset?>("applyGistHubStylePreset", Picker, e.Value?.ToString());
        if (preset is null) return;
        Style = preset.Style;
        Theme = preset.Theme;
    }

    private string StyleId => $"{PanelId}-style";
    private string StyleHintId => $"{PanelId}-style-hint";
    private string Style = "default";
    private List<StyleOption> Styles = [];
    private sealed record StyleOption(string Id, string Name, string Description, string Group);
    private string StyleDescription => Styles.FirstOrDefault(s => s.Id == Style)?.Description ?? "";

    private async Task ChangeStyle(ChangeEventArgs e)
    {
        await JS.InvokeVoidAsync("applyGistHubTheme", Theme, false);
        Style = await JS.InvokeAsync<string>("applyGistHubStyle", e.Value?.ToString());
    }

    private async Task RestoreStyle()
    {
        Style = await JS.InvokeAsync<string>("applyGistHubStyle", "default");
    }
    private readonly string PanelId = $"theme-picker-{Guid.NewGuid():N}";
    private string HintId => $"{PanelId}-hint";
    private bool IsInitialized;
    private string Theme = "";
    private List<ThemeOption> Palettes = [];
    private string SelectedName => Palettes.FirstOrDefault(p => p.Id == Theme)?.Name ?? "Themes";
    private sealed record ThemeOption(string Id, string Name, string Chrome, string Primary, string Secondary, string Source);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Presets.AddRange(await JS.InvokeAsync<StylePreset[]>("getGistHubStylePresets"));
            Styles.AddRange(await JS.InvokeAsync<StyleOption[]>("getGistHubStyles"));
            Style = await JS.InvokeAsync<string>("getGistHubStyle");
            Palettes.AddRange(await JS.InvokeAsync<ThemeOption[]>("getGistHubThemes"));
            Theme = await JS.InvokeAsync<string>("getGistHubTheme");
            StateHasChanged();
        }
        else if (!IsInitialized)
        {
            await JS.InvokeVoidAsync("initializeGistHubThemePicker", Picker);
            IsInitialized = true;
        }
    }

    private async Task SelectTheme(string theme)
    {
        Theme = theme;
        await JS.InvokeVoidAsync("commitGistHubThemePicker", Picker, theme);
    }

    private async Task RestoreDefault()
    {
        await RestoreStyle();
        await SelectTheme(await JS.InvokeAsync<string>("getGistHubDefaultTheme"));
    }

    public async ValueTask DisposeAsync()
    {
        if (IsInitialized)
        {
            try { await JS.InvokeVoidAsync("closeGistHubThemePicker", Picker); }
            catch (JSDisconnectedException) { }
        }
    }
}
