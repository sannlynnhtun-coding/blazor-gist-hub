@page "/tools/formula-to-image"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Formula to Image · GistHub</PageTitle>
<section class="space-y-6" aria-labelledby="formula-title">
    <div>
        <div class="neo-kicker mb-2">Workbench / Math</div>
        <h2 id="formula-title" class="text-3xl font-black tracking-tight">Formula to Image</h2>
        <p class="text-muted-foreground mt-2">Turn LaTeX math into an image with a live preview. Rendering stays in your browser.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <label class="code-image-field"><span>Title (optional)</span><input id="formula-name" maxlength="80" @bind="Title" @bind:event="oninput" @bind:after="Changed" /></label>
        <label class="code-image-field"><span>Author (optional)</span><input maxlength="80" @bind="Author" @bind:event="oninput" @bind:after="Changed" /></label>
        <label class="code-image-field"><span>Formula size: @FontSize px</span><input id="formula-size" type="range" min="18" max="96" @bind="FontSize" @bind:after="Changed" /></label>
        <label class="code-image-field"><span>Padding: @Padding px</span><input type="range" min="0" max="96" step="4" @bind="Padding" @bind:after="Changed" /></label>
        <label class="code-image-field"><span>Text color</span><input id="formula-color" type="color" @bind="Color" @bind:after="Changed" /></label>
        <label class="code-image-field"><span>Background color</span><input type="color" @bind="Background" @bind:after="Changed" disabled="@Transparent" /></label>
        <label class="flex items-center gap-2"><input id="formula-transparent" type="checkbox" @bind="Transparent" @bind:after="Changed" />Transparent background (PNG, WebP, SVG)</label>
        <label class="flex items-center gap-2"><input type="checkbox" @bind="DisplayMode" @bind:after="Changed" />Display math</label>
        <label class="code-image-field"><span>Export format</span><select id="formula-format" @bind="Format"><option value="png">PNG</option><option value="jpeg">JPEG (white behind transparency)</option><option value="webp">WebP</option><option value="svg">SVG (browser MathML)</option></select></label>
        @if (Format is "jpeg" or "webp") { <label class="code-image-field"><span>Quality: @Quality%</span><input type="range" min="50" max="100" step="5" @bind="Quality" /></label> }
        <label class="code-image-field"><span>Load example</span><select id="formula-example" @onchange="LoadExample"><option value="einstein">Mass–energy</option><option value="quadratic">Quadratic formula</option><option value="integral">Gaussian integral</option><option value="matrix">Matrix</option><option value="sum">Infinite sum</option></select></label>
    </div>
    <div class="flex flex-wrap gap-4 items-center">
        <button id="formula-download" class="btn btn-primary btn-md" @onclick="DownloadAsync" disabled="@(!Ready || Exporting)">@(Exporting ? "Exporting…" : $"Download {Format.ToUpperInvariant()}")</button>
        <button id="formula-copy" class="btn btn-secondary btn-md" @onclick="CopySettingsAsync">Copy settings</button>
        <label for="formula-file">Open math .tex (up to 16 KB)</label><InputFile id="formula-file" accept=".tex,.txt,text/plain" OnChange="ImportAsync" />
    </div>
    @if (Error is not null) { <p id="formula-error" role="alert" class="text-destructive">@Error</p> }
    <p id="formula-status" role="status" aria-live="polite">@Status</p>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
            <label for="formula-source" class="block font-bold mb-2">LaTeX math (without $ delimiters or document wrapper)</label>
            <textarea id="formula-source" class="w-full bg-card border border-border rounded-md p-4 font-mono" rows="12" maxlength="16384" @bind="Source" @bind:event="oninput" @bind:after="Changed" spellcheck="false"></textarea>
        </div>
        <div class="min-w-0">
            <h3 class="font-bold mb-2">Live preview</h3>
            <div id="formula-preview" @ref="Preview" class="border border-border rounded-md p-4 overflow-auto" style="background:repeating-conic-gradient(#eeeeee 0% 25%, #cccccc 0% 50%) 50% / 20px 20px" aria-label="Formula preview"></div>
        </div>
    </div>
    <p class="text-sm text-muted-foreground">PNG and WebP export at 2× resolution. SVG includes MathML for modern browsers; use PNG for slides and editors without MathML support. KaTeX supports math syntax, not full LaTeX documents. Drafts are not saved automatically.</p>
</section>

@code {
    private string Source = "E = mc^2", Title = "", Author = "", Color = "#172033", Background = "#ffffff", Format = "png", Status = "Rendering preview…";
    private int FontSize = 40, Padding = 32, Quality = 90, Revision;
    private bool Transparent, DisplayMode = true, NeedsPreview = true, Ready, Exporting;
    private string? Error;
    private ElementReference Preview;
    private IJSObjectReference? Module;

    private void Changed() { Revision++; NeedsPreview = true; Ready = false; Error = null; Status = "Rendering preview…"; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!NeedsPreview) return;
        NeedsPreview = false;
        var revision = Revision;
        try
        {
            Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/formulaImage.js");
            var ready = await Module.InvokeAsync<bool>("render", Preview, Source, Settings());
            if (revision != Revision) return;
            Ready = ready;
            Status = ready ? "Preview ready. Image exports use 2× resolution." : "Rendering preview…";
        }
        catch (JSException ex) { if (revision == Revision) { Error = ex.Message.Split('\n')[0]; Status = "Fix the formula to enable export."; Ready = false; } }
        StateHasChanged();
    }

    private object Settings() => new { title = Title, author = Author, color = Color, background = Background, transparent = Transparent, displayMode = DisplayMode, fontSize = FontSize, padding = Padding, format = Format, quality = Quality / 100.0 };

    private void LoadExample(ChangeEventArgs args)
    {
        Source = args.Value?.ToString() switch {
            "quadratic" => @"x = \frac{-b \pm \sqrt{b^2 - 4ac}}{2a}",
            "integral" => @"\int_{-\infty}^{\infty} e^{-x^2}\,dx = \sqrt{\pi}",
            "matrix" => @"A = \begin{pmatrix} a & b \\ c & d \end{pmatrix}",
            "sum" => @"\sum_{n=1}^{\infty} \frac{1}{n^2} = \frac{\pi^2}{6}",
            _ => "E = mc^2"
        };
        Changed();
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        if (args.File.Size > 16 * 1024) { Error = "Formula files must be 16 KB or smaller."; return; }
        try { using var reader = new StreamReader(args.File.OpenReadStream(16 * 1024)); Source = await reader.ReadToEndAsync(); Changed(); }
        catch (Exception ex) when (ex is IOException or JSException) { Error = "This formula file could not be read."; }
    }

    private async Task DownloadAsync()
    {
        if (!Ready || Module is null || Exporting) return;
        Exporting = true; Error = null;
        try { await Module.InvokeVoidAsync("download", Preview, Format, Title, Quality / 100.0); Status = "Formula downloaded."; }
        catch (JSException) { Error = "Export failed. Try PNG or a smaller expression."; }
        finally { Exporting = false; }
    }

    private async Task CopySettingsAsync()
    {
        try { Status = await JS.InvokeAsync<bool>("copyToClipboard", System.Text.Json.JsonSerializer.Serialize(Settings())) ? "Settings copied." : "Could not copy. Focus this page and retry."; }
        catch (JSException) { Status = "Clipboard access is unavailable."; }
    }

    public async ValueTask DisposeAsync()
    {
        if (Module is null) return;
        try { await Module.InvokeVoidAsync("clear", Preview); await Module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
