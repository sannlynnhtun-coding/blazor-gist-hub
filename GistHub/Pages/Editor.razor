@page "/editor"
@page "/editor/{GistId}"
@using GistHub.Models
@using GistHub.Services
@using System.Net
@inject IStorageService Storage
@inject AppState AppState
@inject NavigationManager Navigation
@inject IGithubService Github

<div class="neo-page max-w-7xl mx-auto space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <!-- Header -->
    <div class="neo-page-heading flex flex-col md:flex-row md:items-center justify-between gap-6 pb-7 border-b">
        <div class="flex items-center gap-4">
            <button @onclick='() => Navigation.NavigateTo("/my-gists")' class="btn btn-outline btn-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            </button>
            <div>
                <span class="neo-kicker mb-2">Code workshop</span>
                <h1 class="text-3xl font-semibold tracking-tight">@(string.IsNullOrEmpty(GistId) ? "Create a new gist" : "Edit your gist")</h1>
                <p class="text-muted-foreground text-sm font-semibold">A focused workspace for your cloud snippets.</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
             <button @onclick="HandleSave" disabled="@IsLoading" class="btn btn-primary btn-lg">
                @if (IsLoading) { <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div> }
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud-upload"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M12 12v9"/><path d="m16 16-4-4-4 4"/></svg>
                @(string.IsNullOrEmpty(GistId) ? "Publish to GitHub" : "Save Changes")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="p-4 rounded-xl border border-border bg-[#FDEBEC] text-sm text-[#9F2F2D] font-semibold">
            @ErrorMessage
        </div>
    }

    <!-- Main Workspace -->
    @if (IsEditorUnavailable)
    {
        <div class="p-12 border border-dashed rounded-xl flex flex-col items-center justify-center text-center space-y-4">
            <h2 class="text-2xl font-semibold tracking-tight">Snippet unavailable</h2>
            <p class="text-sm text-muted-foreground max-w-xl">GitHub could not load this snippet for editing. Check that this gist still exists and that the current token belongs to the owner.</p>
            <button @onclick='() => Navigation.NavigateTo("/my-gists")' class="btn btn-primary btn-md">Back to My Gists</button>
        </div>
    }
    else
    {
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Sidebar Settings -->
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-card border rounded-xl p-6 space-y-6">
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase tracking-widest text-muted-foreground ml-1">Description</label>
                    <textarea @bind="Description" rows="4" placeholder="What does this snippet do? #hashtags supported" class="w-full bg-secondary/30 border rounded-lg py-3 px-4 focus:ring-2 focus:ring-primary/10 outline-none transition-all text-sm resize-none"></textarea>
                </div>

                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase tracking-widest text-muted-foreground ml-1">Filename</label>
                    <div class="relative">
                        <input @bind="Filename" type="text" placeholder="script.js" class="w-full bg-secondary/30 border rounded-lg py-3 px-10 focus:ring-2 focus:ring-primary/10 outline-none transition-all font-mono text-xs" />
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-code absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground"><path d="M10 12.5 8 15l2 2.5"/><path d="m14 12.5 2 2.5-2 2.5"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/></svg>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase tracking-widest text-muted-foreground ml-1">Privacy Level</label>
                    <div class="grid grid-cols-2 gap-2 p-1 bg-secondary/50 rounded-lg border">
                        <button @onclick="() => IsPublic = true" disabled="@(!string.IsNullOrEmpty(GistId))" class="btn btn-sm @(IsPublic ? "btn-secondary bg-background" : "btn-ghost text-muted-foreground") @(!string.IsNullOrEmpty(GistId) ? "cursor-not-allowed opacity-50" : "")">
                            Public
                        </button>
                        <button @onclick="() => IsPublic = false" disabled="@(!string.IsNullOrEmpty(GistId))" class="btn btn-sm @(!IsPublic ? "btn-secondary bg-background" : "btn-ghost text-muted-foreground") @(!string.IsNullOrEmpty(GistId) ? "cursor-not-allowed opacity-50" : "")">
                            Secret
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(GistId))
                    {
                        <p class="text-[10px] text-muted-foreground mt-1 px-1">Note: GitHub doesn't allow changing privacy after creation.</p>
                    }
                </div>
            </div>

            <!-- Helpful Tips -->
            <div class="bg-[#EDF3EC] rounded-xl p-6 border border-border">
                <h4 class="text-xs font-bold text-[#346538] uppercase tracking-widest mb-3">Sync Status</h4>
                <div class="flex items-center gap-3">
                    <div class="w-2 h-2 rounded-full bg-[#346538]"></div>
                    <span class="text-xs font-semibold text-[#346538]">Encrypted & Ready</span>
                </div>
            </div>
        </div>

        <!-- Editor Console -->
        <div class="lg:col-span-3 flex flex-col h-[70vh] min-h-[600px]">
            <div class="flex-1 bg-[#111111] rounded-xl border border-border relative overflow-hidden group">
                <!-- Editor Header Mockup -->
                <div class="absolute top-0 inset-x-0 h-12 bg-card border-b border-border flex items-center justify-between px-6 z-10">
                    <div class="flex gap-1.5">
                        <div class="w-2.5 h-2.5 rounded-full bg-border"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-border"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-border"></div>
                    </div>
                    <div class="flex items-center gap-4">
                        @if (Filename.EndsWith(".md"))
                        {
                            <button @onclick="TogglePreview" class="text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-md transition-all @(IsPreview ? "bg-primary text-primary-foreground" : "bg-secondary text-muted-foreground hover:bg-accent")">
                                Preview
                            </button>
                        }
                        <span class="text-[10px] font-mono text-muted-foreground uppercase tracking-widest font-bold">UTF-8 - @Filename</span>
                    </div>
                </div>

                <!-- Main Textarea / Preview -->
                @if (IsPreview && Filename.EndsWith(".md"))
                {
                    <div @ref="previewContainer" class="w-full h-full pt-16 p-8 overflow-auto prose prose-invert max-w-none prose-pre:bg-transparent prose-pre:p-0"></div>
                }
                else
                {
                    <textarea @bind="Content" @bind:event="oninput" spellcheck="false" class="w-full h-full pt-16 p-8 bg-transparent text-zinc-100 font-mono text-sm md:text-base leading-relaxed outline-none resize-none custom-scrollbar" placeholder="// Start writing your masterpiece here..."></textarea>
                }
                
                <!-- Status Bar -->
                <div class="absolute bottom-6 right-8 text-[10px] font-mono text-zinc-500 uppercase tracking-widest bg-zinc-900 px-3 py-1.5 rounded-md border border-white/10">
                    LN @(Content?.Split('\n').Length ?? 1) COL @(Content?.Length ?? 0)
                </div>
            </div>
        </div>
    </div>
    }
</div>

@code {
    [Parameter] public string? GistId { get; set; }
    [Inject] private IJSRuntime JS { get; set; }

    private string Description { get; set; } = "";
    private string Filename { get; set; } = "main.cs";
    private string OriginalFilename { get; set; } = "";
    private string Content { get; set; } = "";
    private bool IsPublic { get; set; } = true;
    private bool IsLoading { get; set; } = false;
    private bool IsPreview { get; set; } = false;
    private bool IsEditorUnavailable { get; set; } = false;
    private string ErrorMessage { get; set; } = "";
    private ElementReference previewContainer;
    private bool shouldRenderPreview = false;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!string.IsNullOrEmpty(GistId))
        {
            await LoadGistForEditing();
        }
    }

    private async Task LoadGistForEditing()
    {
        var gists = await Storage.GetLocalGistsAsync();
        var gist = gists.FirstOrDefault(g => g.Id == GistId);

        if (gist == null || !HasEditableContent(gist))
        {
            var freshGist = await Github.GetGistByIdAsync(GistId!, AppState.CurrentProfile!.AccessToken);
            if (freshGist != null)
            {
                freshGist.IsSynced = true;
                freshGist.Tags = ParseTags(freshGist.Description);
                await Storage.SaveGistAsync(freshGist);
                gist = freshGist;
            }
        }

        if (gist == null || !HasEditableContent(gist))
        {
            IsEditorUnavailable = true;
            ErrorMessage = BuildGithubErrorMessage("load");
            return;
        }

        Description = gist.Description;
        var firstFile = gist.Files.FirstOrDefault();
        OriginalFilename = firstFile.Key ?? firstFile.Value?.Filename ?? "snippet.txt";
        Filename = string.IsNullOrWhiteSpace(firstFile.Value?.Filename)
            ? OriginalFilename
            : firstFile.Value.Filename;
        Content = firstFile.Value?.Content ?? "";
        IsPublic = gist.Public;
    }

    private static bool HasEditableContent(LocalGist? gist)
        => gist?.Files.Values.Any(file => !string.IsNullOrEmpty(file.Content)) == true;

    private string BuildGithubErrorMessage(string action)
    {
        var error = Github.LastError;
        if (error == null)
        {
            return action == "load"
                ? "Could not load this snippet from GitHub."
                : "Could not save this snippet to GitHub.";
        }

        var detail = string.IsNullOrWhiteSpace(error.Message)
            ? "GitHub API request failed."
            : error.Message;

        return error.StatusCode switch
        {
            HttpStatusCode.Forbidden => $"GitHub rejected this request: {detail}. Your token needs Gists write permission.",
            HttpStatusCode.NotFound => $"Snippet not found on GitHub: {detail}. It may be deleted, owned by another account, or this local cache has a stale ID.",
            HttpStatusCode.UnprocessableEntity => $"GitHub rejected the filename or content: {detail}. Check the filename and try again.",
            _ => $"GitHub rejected this request: {detail}"
        };
    }

    private async Task HandleSave()
    {
        var filename = Filename.Trim();
        ErrorMessage = "";
        if (string.IsNullOrWhiteSpace(filename) || string.IsNullOrEmpty(Content))
        {
            ErrorMessage = "Filename and content are required.";
            return;
        }
        
        IsLoading = true;
        StateHasChanged();

        try 
        {
            Filename = filename;

            LocalGist? result;
            if (string.IsNullOrEmpty(GistId))
            {
                var files = new Dictionary<string, GistFile>
                {
                    { filename, new GistFile { Content = Content } }
                };

                result = await Github.CreateGistAsync(Description, IsPublic, files, AppState.CurrentProfile!.AccessToken);
            }
            else 
            {
                var originalFilename = string.IsNullOrWhiteSpace(OriginalFilename)
                    ? filename
                    : OriginalFilename;
                var files = new Dictionary<string, GistFile>
                {
                    { originalFilename, new GistFile { Filename = filename, Content = Content } }
                };

                result = await Github.UpdateGistAsync(GistId, Description, files, AppState.CurrentProfile!.AccessToken);
            }

            if (result != null)
            {
                result.IsSynced = true;
                result.Tags = ParseTags(Description);
                await Storage.SaveGistAsync(result);
                Navigation.NavigateTo("/my-gists");
            }
            else
            {
                ErrorMessage = BuildGithubErrorMessage("save");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving gist: {ex.Message}");
            ErrorMessage = $"Could not save this snippet: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private List<string> ParseTags(string description)
    {
        if (string.IsNullOrEmpty(description)) return new List<string>();
        var tags = new List<string>();
        var parts = description.Split(' ');
        foreach(var part in parts)
        {
            if (part.StartsWith("#") && part.Length > 1)
                tags.Add(part.Substring(1).TrimEnd(',', '.', '!', '?', ';'));
        }
        return tags;
    }

    private async Task TogglePreview()
    {
        IsPreview = !IsPreview;
        if (IsPreview)
        {
            shouldRenderPreview = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldRenderPreview && previewContainer.Id != null)
        {
            shouldRenderPreview = false;
            await JS.InvokeVoidAsync("renderMarkdown", previewContainer, Content);
        }
    }
}
