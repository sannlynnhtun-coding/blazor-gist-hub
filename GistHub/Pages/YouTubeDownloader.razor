@page "/tools/youtube-downloader"
@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>YouTube Downloader · GistHub</PageTitle>
<section class="downloader space-y-6">
    <div>
        <div class="neo-kicker mb-2">Workbench / Local tools</div>
        <h2 class="text-3xl font-black tracking-tight">YouTube Downloader</h2>
        <p class="text-muted-foreground mt-2">Choose a video or audio format and save it to your computer.</p>
    </div>
    @if (!Ready)
    {
        <div class="downloader-notice" role="status">
            <strong>@(Checking ? "Checking local downloader…" : "Local downloader unavailable")</strong>
            <p>@Message</p>
            @if (!Checking)
            {
                <p>Start GistHub with <code>Start-LocalDownloader.cmd</code>, then open Tools → YouTube Downloader in the local window.</p>
                <button class="btn btn-outline btn-md mt-3" @onclick="CheckHealthAsync">Check again</button>
            }
        </div>
    }
    <form class="downloader-input" @onsubmit="InspectAsync" @onsubmit:preventDefault>
        <div class="flex-1 min-w-0">
            <label for="youtube-url" class="block text-sm font-bold mb-2">YouTube video URL</label>
            <input id="youtube-url" type="url" required maxlength="2048" @bind="Url" placeholder="https://www.youtube.com/watch?v=…" disabled="@Busy" class="w-full bg-card border border-border rounded-md px-4 py-3" />
        </div>
        <button class="btn btn-primary btn-md" type="submit" disabled="@(!Ready || Busy)">@(Inspecting ? "Looking up…" : "Find downloads")</button>
    </form>
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="downloader-notice text-destructive" role="alert">@Error</div>
    }
    @if (Status is not null)
    {
        <div class="downloader-notice" role="status" aria-live="polite">
            <p>@Status.Message</p>
            @if (Downloading)
            {
                <progress class="w-full mt-3" aria-label="Preparing download"></progress>
                <button class="btn btn-outline btn-md mt-3" @onclick="CancelAsync">Cancel download</button>
            }
            @if (Status.State == "complete" && Status.FileUrl is not null)
            {
                <a class="btn btn-primary btn-md mt-3" href="@Status.FileUrl" download="@Status.Filename">Save file again</a>
                <p class="text-sm mt-2">If the download did not start automatically, use Save file again. Files remain available locally for one hour.</p>
            }
        </div>
    }
    @if (Preview is not null)
    {
        <div class="downloader-card">
            <div class="flex gap-4 items-center p-5 border-b border-border">
                @if (Preview.Thumbnail is not null)
                {
                    <img src="@Preview.Thumbnail" alt="Video thumbnail" class="downloader-thumbnail" referrerpolicy="no-referrer" onerror="this.style.display='none'" />
                }
                <div class="min-w-0">
                    <h3 class="font-black text-lg break-words">@Preview.Title</h3>
                    <p class="text-sm text-muted-foreground mt-1">@Preview.Channel @DurationLabel</p>
                </div>
            </div>
            <div class="flex border-b border-border" role="tablist" aria-label="Media type">
                <button id="video-tab" class="downloader-tab @(Kind == "video" ? "selected" : "")" role="tab" aria-selected="@(Kind == "video")" aria-controls="formats-panel" @onclick='() => Kind = "video"'>Video</button>
                <button id="audio-tab" class="downloader-tab @(Kind == "audio" ? "selected" : "")" role="tab" aria-selected="@(Kind == "audio")" aria-controls="formats-panel" @onclick='() => Kind = "audio"'>Audio</button>
            </div>
            <div id="formats-panel" role="tabpanel" aria-labelledby="@(Kind + "-tab")" class="overflow-x-auto">
                <table class="downloader-table">
                    <thead><tr><th scope="col">Quality</th><th scope="col">Format</th><th scope="col">Size</th><th scope="col"><span class="sr-only">Download</span></th></tr></thead>
                    <tbody>
                        @foreach (var option in Preview.Options.Where(option => option.Kind == Kind))
                        {
                            <tr>
                                <th scope="row">@option.Quality</th>
                                <td>@option.Format.ToUpperInvariant()</td>
                                <td>@SizeLabel(option)</td>
                                <td><button class="btn btn-primary btn-md" disabled="@Busy" @onclick="() => DownloadAsync(option)">Download</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Preview.Options.Any(option => option.Kind == Kind))
                {
                    <p class="p-5 text-muted-foreground">No @Kind formats are available for this video.</p>
                }
            </div>
        </div>
        <p class="text-xs text-muted-foreground">Sizes marked ≈ are estimates. MP3 size is determined after conversion.</p>
    }
</section>

@code {
    private readonly CancellationTokenSource Lifetime = new();
    private string Url = "";
    private string Kind = "video";
    private string Message = "";
    private string Error = "";
    private bool Ready;
    private bool Checking;
    private bool Inspecting;
    private bool Starting;
    private VideoPreview? Preview;
    private DownloadStatus? Status;
    private IJSObjectReference? Module;
    private bool Downloading => Status?.State is "queued" or "downloading";
    private bool Busy => Inspecting || Starting || Downloading;
    private string DurationLabel => Preview?.Duration is { } seconds ? $"· {TimeSpan.FromSeconds(seconds):g}" : "";
    private static string SizeLabel(DownloadOption option) => option.SizeBytes is { } size ? $"{(option.Estimated ? "≈ " : "")}{size / 1048576d:0.##} MB" : "Unknown";

    protected override Task OnInitializedAsync() => CheckHealthAsync();

    private async Task CheckHealthAsync()
    {
        Checking = true;
        Ready = false;
        try
        {
            var uri = new Uri(Navigation.BaseUri);
            if (!uri.IsLoopback || uri.Port != 5188)
            {
                Message = "This tool runs in the local GistHub window at http://localhost:5188.";
                return;
            }
            var health = await SendAsync<DownloaderHealth>(HttpMethod.Get, "health");
            Ready = health.Ready;
            Message = health.Message;
        }
        catch (Exception ex) when (!Lifetime.IsCancellationRequested) { Message = ex is OperationCanceledException ? "The local service did not respond. Restart the launcher and try again." : ex.Message; }
        finally { Checking = false; }
    }

    private async Task InspectAsync()
    {
        if (!Ready || Busy) return;
        Inspecting = true;
        Error = "";
        Preview = null;
        Status = null;
        try
        {
            Preview = await SendAsync<VideoPreview>(HttpMethod.Post, "inspect", new InspectVideoRequest(Url));
            Kind = Preview.Options.Any(option => option.Kind == "video") ? "video" : "audio";
        }
        catch (Exception ex) when (!Lifetime.IsCancellationRequested) { Error = ex is OperationCanceledException ? "Video lookup timed out. Try again." : ex.Message; }
        finally { Inspecting = false; }
    }

    private async Task DownloadAsync(DownloadOption option)
    {
        if (Preview is null || Busy) return;
        Starting = true;
        Error = "";
        try
        {
            Status = await SendAsync<DownloadStatus>(HttpMethod.Post, "downloads", new StartDownloadRequest(Preview.Token, option.Id));
            Starting = false;
            StateHasChanged();
            while (Downloading)
            {
                await Task.Delay(1000, Lifetime.Token);
                Status = await SendAsync<DownloadStatus>(HttpMethod.Get, $"downloads/{Status!.Id}");
                StateHasChanged();
            }
            if (Status?.State == "complete")
            {
                Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/localDownloader.js");
                await Module.InvokeVoidAsync("saveFile", Status.FileUrl, Status.Filename);
            }
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            var message = ex is OperationCanceledException ? "The download connection timed out. Try again." : ex.Message;
            if (Downloading && Status is not null)
            {
                await CancelAsync();
                Status = Status with { State = "failed", Message = "Download interrupted. Try again." };
            }
            Error = message;
        }
        finally { Starting = false; }
    }

    private async Task CancelAsync()
    {
        if (Status is null || !Downloading) return;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Delete, $"api/downloader/downloads/{Status.Id}");
            request.Headers.Add("X-GistHub-Local", "1");
            using var response = await Http.SendAsync(request, Lifetime.Token);
            response.EnsureSuccessStatusCode();
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { Error = ex.Message; }
    }

    private async Task<T> SendAsync<T>(HttpMethod method, string path, object? payload = null)
    {
        using var request = new HttpRequestMessage(method, "api/downloader/" + path);
        request.Headers.Add("X-GistHub-Local", "1");
        if (payload is not null) request.Content = JsonContent.Create(payload);
        using var response = await Http.SendAsync(request, Lifetime.Token);
        if (!response.IsSuccessStatusCode)
        {
            var text = await response.Content.ReadAsStringAsync(Lifetime.Token);
            try
            {
                using var problem = System.Text.Json.JsonDocument.Parse(text);
                if (problem.RootElement.TryGetProperty("detail", out var detail)) throw new HttpRequestException(detail.GetString());
            }
            catch (System.Text.Json.JsonException) { }
            throw new HttpRequestException($"Local downloader request failed ({(int)response.StatusCode}). Restart the launcher and try again.");
        }
        return await response.Content.ReadFromJsonAsync<T>(Lifetime.Token) ?? throw new HttpRequestException("The local downloader returned an empty response.");
    }

    public async ValueTask DisposeAsync()
    {
        Lifetime.Cancel();
        if (Downloading && Status is not null)
        {
            try
            {
                using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(3));
                using var request = new HttpRequestMessage(HttpMethod.Delete, $"api/downloader/downloads/{Status.Id}");
                request.Headers.Add("X-GistHub-Local", "1");
                using var response = await Http.SendAsync(request, timeout.Token);
            }
            catch (HttpRequestException) { }
            catch (OperationCanceledException) { }
        }
        if (Module is not null) await Module.DisposeAsync();
        Lifetime.Dispose();
    }
}
