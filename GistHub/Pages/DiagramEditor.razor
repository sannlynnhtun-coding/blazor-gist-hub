@page "/tools/diagram-editor"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppState AppState
@inject DiagramGistService DiagramGists
@inject IStorageService Storage

<PageTitle>Diagram Editor · GistHub</PageTitle>
<NavigationLock ConfirmExternalNavigation="@Dirty" OnBeforeInternalNavigation="BeforeNavigation" />
<section class="diagram-workspace" @ref="Workspace">
    <header class="diagram-heading">
        <div><div class="neo-kicker">Workbench</div><h2>Diagram Editor</h2></div>
        <div class="diagram-actions">
            <button @onclick="() => LibraryVisible = !LibraryVisible" aria-expanded="@LibraryVisible">Library</button>
            <button @onclick="Fullscreen">Fullscreen</button>
        </div>
    </header>
    <p class="diagram-note">Editing uses the online diagrams.net service. Drafts stay in this browser; download a .drawio file for backup. Desktop or tablet works best.</p>
    @if (Error is not null) {
        <div class="diagram-error" role="alert">@Error
            @if (Selected is not null) { <button disabled="@Busy" @onclick="DownloadRecovery">Download recovery source</button> }
        </div>
    }
    <div class="diagram-body">
        @if (LibraryVisible)
        {
            <aside class="diagram-library" aria-label="Local diagrams">
                <label for="diagram-title">Diagram name</label>
                <input id="diagram-title" @bind="Title" maxlength="120" />
                <div class="diagram-actions">
                    <button disabled="@(Editor is null || Busy)" @onclick="New">New</button>
                    <label class="diagram-upload">Import .drawio<input type="file" accept=".drawio,.xml" @ref="FileInput" @onchange="Import" disabled="@(Editor is null || Busy)" /></label>
                </div>
                <label for="diagram-search">Find a draft</label>
                @if (AppState.IsAuthenticated && CurrentOwner != "guest")
                { <button disabled="@Busy" @onclick="ShowGuestDrafts">Browse guest drafts</button> }
                @if (CurrentOwner != Owner)
                {
                    <p>Viewing guest or previous-account drafts. Copy a selected draft to your active account before saving to GitHub.</p>
                    <button disabled="@Busy" @onclick="ShowAccountDrafts">Active account drafts</button>
                }
                <input id="diagram-search" @bind="Search" @bind:event="oninput" placeholder="Search names" />
                <ul>
                    @foreach (var doc in Documents.Where(d => d.Title.Contains(Search, StringComparison.OrdinalIgnoreCase)))
                    {
                        <li><button class="@(Selected?.Id == doc.Id ? "selected" : "")" disabled="@Busy" @onclick="() => Open(doc.Id)">@doc.Title</button></li>
                    }
                </ul>
                @if (Documents.Count == 0) { <p>No drafts yet. Create a diagram or import an editable file.</p> }
                @if (Selected is not null)
                {
                    <div class="diagram-actions">
                        <button disabled="@Busy" @onclick="Rename">Rename</button>
                        <button disabled="@Busy" @onclick="Duplicate">Duplicate</button>
                        <button disabled="@Busy" @onclick="Delete">Delete</button>
                    </div>
                }
            </aside>
        }
        <div class="diagram-main">
            <div class="diagram-actions diagram-export">
                <button disabled="@(Selected is null || Busy)" @onclick="DownloadSource">Download .drawio</button>
                <button disabled="@(!Ready || Busy)" @onclick="DownloadImage">Export @Export.Format.ToUpperInvariant()</button>
                <button disabled="@(Selected is null || Busy)" @onclick="Retry">Retry editor</button>
            </div>
            <p role="status" aria-live="polite">@Status</p>
            <details class="diagram-gist">
                <summary>Image export settings and presets</summary>
                <div class="diagram-preset-grid">
                    <label>Saved preset<select value="@Export.Id" @onchange="ChoosePreset"><option value="">Custom settings</option>@foreach (var preset in Presets) { <option value="@preset.Id">@preset.Name</option> }</select></label>
                    <label>Format<select @bind="Export.Format"><option value="png">PNG</option><option value="svg">SVG</option></select></label>
                    <label>PNG scale<input type="number" min="1" max="4" step="0.5" @bind="Export.Scale" disabled="@(Export.Format != "png")" /></label>
                    <label>Border (pixels)<input type="number" min="0" max="100" @bind="Export.Border" /></label>
                    <label class="diagram-checkbox"><input type="checkbox" @bind="Export.Transparent" disabled="@(Export.Format != "png")" /> Transparent PNG</label>
                    <label class="diagram-checkbox"><input type="checkbox" @bind="Export.CurrentPage" /> Current page only</label>
                    <label>Preset name<input @bind="Export.Name" maxlength="80" /></label>
                </div>
                <div class="diagram-actions">
                    <button disabled="@(Editor is null || Busy)" @onclick="SavePreset">Save preset</button>
                    <button disabled="@Busy" @onclick="() => Export = new()">New preset</button>
                    <button disabled="@(Busy || Export.Id.Length == 0)" @onclick="DeletePreset">Delete preset</button>
                </div>
            </details>
            <details class="diagram-gist">
                <summary>GitHub Gist</summary>
                <label for="diagram-gist-id">Open Gist ID or URL</label>
                <div class="diagram-actions">
                    <input id="diagram-gist-id" @bind="GistInput" placeholder="https://gist.github.com/…" />
                    <button disabled="@(Editor is null || Busy)" @onclick="FindGist">Find diagram files</button>
                </div>
                @if (RemoteGist is not null)
                {
                    <label for="diagram-gist-file">Diagram file</label>
                    <select id="diagram-gist-file" @bind="RemoteFilename">
                        @foreach (var file in RemoteGist.Files.Keys.Where(f => f.EndsWith(".drawio", StringComparison.OrdinalIgnoreCase) || f.EndsWith(".xml", StringComparison.OrdinalIgnoreCase)))
                        { <option value="@file">@file</option> }
                    </select>
                    <button disabled="@(Busy || string.IsNullOrEmpty(RemoteFilename))" @onclick="OpenRemote">Open as local draft</button>
                    <p>@(RemoteGist.Public ? "Public Gist" : "Secret Gist") · @RemoteGist.Owner?.Login</p>
                }
                @if (!AppState.IsAuthenticated)
                { <p><a href="login">Connect GitHub</a> to save diagrams to a Gist. Guest drafts remain in the guest library.</p> }
                else if (CurrentOwner != Owner)
                { <button disabled="@Busy" @onclick="CopyToAccount">Copy current draft to active account</button> }
                else
                {
                    <label for="diagram-gist-name">Filename for a new Gist</label>
                    <input id="diagram-gist-name" @bind="GistFilename" maxlength="127" />
                    <label class="diagram-checkbox"><input type="checkbox" @bind="PublicGist" /> Make new Gist public</label>
                    <p>Secret Gists are accessible to anyone with their link.</p>
                    <div class="diagram-actions">
                        @if (Selected?.GistId is not null)
                        { <button disabled="@(Busy || Selected is null)" @onclick="UpdateRemote">Update linked Gist</button> }
                        <button disabled="@(Busy || Selected is null)" @onclick="CreateRemote">Save as new Gist</button>
                    </div>
                }
                @if (Selected?.GistId is not null)
                { <a href="@($"https://gist.github.com/{Selected.GistId}")" target="_blank" rel="noopener noreferrer">View linked Gist</a> }
                @if (RemoteStatus is not null) { <p role="status">@RemoteStatus</p> }
            </details>
            <div class="diagram-frame" @ref="FrameHost"></div>
        </div>
    </div>
</section>

@code {
    private ElementReference Workspace, FrameHost, FileInput;
    private IJSObjectReference? Module, Editor;
    private DotNetObjectReference<DiagramEditor>? Callback;
    private List<DiagramDocument> Documents = [];
    private DiagramDocument? Selected;
    private string Title = "Untitled diagram", Search = "", Status = "Choose or create a diagram.";
    private string? Error;
    private string GistInput = "", GistFilename = "diagram.drawio", RemoteFilename = "";
    private bool PublicGist;
    private LocalGist? RemoteGist;
    private string? RemoteStatus;
    private DiagramExportPreset Export = new();
    private List<DiagramExportPreset> Presets = [];
    private bool Ready, Dirty, Busy, LibraryVisible = true, Disposed;
    private string Owner => AppState.CurrentProfile?.GithubUsername.Trim().ToLowerInvariant() is { Length: > 0 } username ? "github:" + username : "guest";
    private string CurrentOwner = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        AppState.OnChange += ProfileChanged;
        await Run(async () => {
            Module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/diagramEditor.js");
            Callback = DotNetObjectReference.Create(this);
            CurrentOwner = Owner;
            Editor = await Module.InvokeAsync<IJSObjectReference>("create", FrameHost, Callback, CurrentOwner);
            await Refresh();
        });
    }

    private async Task Run(Func<Task> action)
    {
        if (Busy || Disposed) return;
        Busy = true; Error = null;
        try { await action(); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or HttpRequestException or TaskCanceledException) { Error = ex.Message; }
        finally { Busy = false; if (!Disposed) StateHasChanged(); }
    }
    private async Task Refresh() {
        Documents = await Editor!.InvokeAsync<List<DiagramDocument>>("list");
        Presets = await Editor!.InvokeAsync<List<DiagramExportPreset>>("presets");
        if (Export.Id.Length > 0 && !Presets.Any(p => p.Id == Export.Id)) Export = new();
    }
    private void Select(DiagramDocument? doc) { Selected = doc; if (doc is not null) Title = doc.Title; }
    private Task New() => Run(async () => { Select(await Editor!.InvokeAsync<DiagramDocument>("newDocument", Title)); await Refresh(); });
    private Task Open(string id) => Run(async () => { Select(await Editor!.InvokeAsync<DiagramDocument>("open", id)); await Refresh(); });
    private Task Rename() => Run(async () => { Select(await Editor!.InvokeAsync<DiagramDocument>("rename", Title)); await Refresh(); });
    private Task Duplicate() => Run(async () => { Select(await Editor!.InvokeAsync<DiagramDocument>("duplicate")); await Refresh(); });
    private Task Import() => Run(async () => { var doc = await Editor!.InvokeAsync<DiagramDocument?>("importFile", FileInput); if (doc is not null) Select(doc); await Refresh(); });
    private Task DownloadSource() => Download("xml");
    private Task DownloadRecovery() => Run(async () => await Editor!.InvokeVoidAsync("recoverySource"));
    private Task DownloadImage() => Run(async () => await Editor!.InvokeVoidAsync("download", Export.Format, Export));
    private Task Download(string format) => Run(async () => await Editor!.InvokeVoidAsync("download", format));
    private Task Retry() => Run(async () => await Editor!.InvokeVoidAsync("retry"));
    private void ChoosePreset(ChangeEventArgs args) {
        var preset = Presets.FirstOrDefault(p => p.Id == args.Value?.ToString());
        Export = preset is null ? new() : new() { Id = preset.Id, Name = preset.Name, Format = preset.Format, Scale = preset.Scale, Border = preset.Border, Transparent = preset.Transparent, CurrentPage = preset.CurrentPage };
    }
    private Task SavePreset() => Run(async () => { Export = await Editor!.InvokeAsync<DiagramExportPreset>("savePreset", Export); await Refresh(); });
    private Task DeletePreset() => Run(async () => {
        if (await JS.InvokeAsync<bool>("confirm", $"Delete export preset '{Export.Name}'?")) { await Editor!.InvokeVoidAsync("removePreset", Export.Id); Export = new(); await Refresh(); }
    });
    private Task Fullscreen() => Run(async () => await Editor!.InvokeVoidAsync("fullscreen", Workspace));
    private Task FindGist() => Run(async () => {
        RemoteGist = null; RemoteFilename = "";
        RemoteGist = await DiagramGists.LoadAsync(GistInput, AppState.CurrentProfile?.AccessToken);
        RemoteFilename = RemoteGist.Files.Keys.FirstOrDefault(f => f.EndsWith(".drawio", StringComparison.OrdinalIgnoreCase) || f.EndsWith(".xml", StringComparison.OrdinalIgnoreCase)) ?? "";
        if (RemoteFilename.Length == 0) throw new InvalidOperationException("This Gist contains no .drawio or XML files.");
    });
    private Task OpenRemote() => Run(async () => {
        if (RemoteGist is null) return;
        var xml = DiagramGistService.ReadSource(RemoteGist, RemoteFilename);
        Select(await Editor!.InvokeAsync<DiagramDocument>("newDocument", RemoteFilename, xml));
        if (CurrentOwner == Owner && AppState.CurrentProfile is { } profile && string.Equals(RemoteGist.Owner?.Login, profile.GithubUsername, StringComparison.OrdinalIgnoreCase))
            Select(await Editor!.InvokeAsync<DiagramDocument>("linkGist", RemoteGist.Id, RemoteFilename, xml));
        RemoteStatus = RemoteGist.Public ? "Opened from a public Gist." : "Opened from a secret Gist.";
        await Refresh();
    });
    private Task CopyToAccount() => Run(async () => {
        if (Selected is null || !AppState.IsAuthenticated) return;
        Select(await Editor!.InvokeAsync<DiagramDocument>("copyToOwner", Owner)); CurrentOwner = Owner; await Refresh();
    });
    private Task ShowGuestDrafts() => Run(async () => {
        await Editor!.InvokeVoidAsync("setOwner", "guest"); CurrentOwner = "guest"; Selected = null; await Refresh();
    });
    private Task ShowAccountDrafts() => Run(async () => {
        await Editor!.InvokeVoidAsync("setOwner", Owner); CurrentOwner = Owner; Selected = null; await Refresh();
    });
    private Task CreateRemote() => SaveRemote(true);
    private Task UpdateRemote() => SaveRemote(false);
    private Task SaveRemote(bool createNew) => Run(async () => {
        var profile = AppState.CurrentProfile ?? throw new InvalidOperationException("Connect GitHub first.");
        if (CurrentOwner != Owner) throw new InvalidOperationException("Open or copy a diagram in the active account first.");
        var doc = await Editor!.InvokeAsync<DiagramDocument>("current");
        RemoteStatus = "Saving to GitHub…";
        LocalGist saved;
        try { saved = await DiagramGists.SaveAsync(doc, profile, GistFilename, PublicGist, createNew); }
        catch { RemoteStatus = "GitHub did not confirm a save. Check My Gists before creating another Gist; the local draft is retained."; throw; }
        if (AppState.CurrentProfile?.Id != profile.Id) throw new InvalidOperationException("Saved to the original account. Reopen its diagram library to see the result.");
        var filename = createNew ? GistFilename.Trim() : doc.GistFilename!;
        RemoteStatus = $"Saved to GitHub ({(saved.Public ? "public" : "secret")}).";
        doc.GistId = saved.Id; doc.GistFilename = filename; doc.RemoteXml = doc.Xml; Select(doc);
        Select(await Editor!.InvokeAsync<DiagramDocument>("linkGist", saved.Id, filename, doc.Xml));
        var existing = (await Storage.GetLocalGistsAsync(profile.GithubUsername)).FirstOrDefault(g => g.Id == saved.Id);
        if (existing is not null) {
            saved.IsBookmarked = existing.IsBookmarked; saved.BookmarkOrder = existing.BookmarkOrder;
            saved.CollectionNames = existing.CollectionNames; saved.CollectionName = existing.CollectionName;
        }
        await Storage.SaveGistAsync(saved); await Refresh();
    });
    private Task Delete() => Run(async () => {
        if (Selected is not null && await JS.InvokeAsync<bool>("confirm", $"Delete local diagram '{Selected.Title}'? This does not delete a GitHub Gist.")) {
            await Editor!.InvokeVoidAsync("remove", Selected.Id); Selected = null; await Refresh();
        }
    });
    [JSInvokable] public Task DiagramStatus(string status, bool ready, bool dirty) => InvokeAsync(() => {
        if (!Disposed) { Status = status; Ready = ready; Dirty = dirty; StateHasChanged(); }
    });
    private async Task BeforeNavigation(LocationChangingContext context)
    {
        if (Editor is null) return;
        try { await Editor.InvokeVoidAsync("checkpoint"); }
        catch (JSException) {
            if (!await JS.InvokeAsync<bool>("confirm", "Some diagram changes could not be saved. Leave this page anyway?")) context.PreventNavigation();
        }
    }
    private void ProfileChanged() => _ = InvokeAsync(async () => {
        if (Editor is null || CurrentOwner == Owner || Disposed) return;
        await Run(async () => { await Editor.InvokeVoidAsync("setOwner", Owner); CurrentOwner = Owner; Selected = null; await Refresh(); });
    });
    public async ValueTask DisposeAsync()
    {
        Disposed = true; AppState.OnChange -= ProfileChanged;
        if (Editor is not null) {
            try { await Editor.InvokeVoidAsync("dispose"); await Editor.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        Callback?.Dispose();
        if (Module is not null) await Module.DisposeAsync();
    }
}
