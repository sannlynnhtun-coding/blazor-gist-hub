@page "/slh-collection"
@using GistHub.Components
@using GistHub.Models
@using GistHub.Services
@inject IGithubService Github
@inject AppState AppState
@inject NavigationManager Navigation
@inject IStorageService Storage

<div class="space-y-12 pb-20">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b">
        <div class="space-y-1">
            <h1 class="text-3xl font-semibold tracking-tight">SLH Collection</h1>
            <p class="text-muted-foreground text-base">
                Public files shared from
                <a href="https://github.com/sannlynnhtun-coding" target="_blank" rel="noopener noreferrer" class="font-semibold text-primary hover:underline ml-1">@@sannlynnhtun.coding</a>
                for everyone.
            </p>
        </div>
        <button @onclick="LoadCollection" class="btn btn-secondary btn-md" disabled="@IsLoading">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw @(IsLoading ? "animate-spin" : "")"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
            Refresh
        </button>
    </div>

    <div class="relative group max-w-2xl mx-auto w-full -mt-6">
        <div class="relative flex items-center bg-card border border-border rounded-xl px-4 py-2 transition-all focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search text-muted-foreground mr-3"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
                type="text"
                placeholder="Search SLH files, description, or tags..."
                @bind="SearchQuery"
                @bind:event="oninput"
                class="flex-1 bg-transparent border-none outline-none text-sm font-medium placeholder:text-muted-foreground/50 h-10" />

            @if (!string.IsNullOrEmpty(SearchQuery))
            {
                <button @onclick='() => SearchQuery = ""' class="p-1.5 hover:bg-muted rounded-lg transition-all text-muted-foreground">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            }

            <div class="ml-4 pl-4 border-l border-border flex items-center gap-2">
                <span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/50">Results</span>
                <span class="text-xs font-bold tabular-nums">@FilteredGists.Count</span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="p-4 rounded-xl bg-[#FBF3DB] border border-border flex items-center justify-between animate-in fade-in slide-in-from-top-4">
            <span class="text-sm font-semibold text-[#956400]">@Message</span>
            <button @onclick='() => Message = ""' class="text-primary hover:scale-110 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </div>
    }

    @if (IsLoading && !SlhGists.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-6">
            @for (int i = 0; i < 4; i++)
            {
                <div class="h-64 bg-muted animate-pulse rounded-xl border border-border"></div>
            }
        </div>
    }
    else if (HasLoadError)
    {
        <div class="flex flex-col items-center justify-center py-20 border border-dashed rounded-xl bg-[#FDEBEC]">
            <p class="text-sm font-medium text-destructive">@ErrorMessage</p>
            <button @onclick="LoadCollection" class="mt-4 btn btn-primary btn-md">Retry</button>
        </div>
    }
    else if (!FilteredGists.Any())
    {
        <div class="flex flex-col items-center justify-center py-20 border border-dashed rounded-xl bg-muted/20">
            <p class="text-sm font-medium text-muted-foreground">No files found for this search.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            @foreach (var gist in FilteredGists)
            {
                <GistCard
                    Id="@gist.Id"
                    AvatarUrl="@(gist.Owner?.AvatarUrl ?? "https://github.com/slh.png")"
                    Author="@(gist.Owner?.Login ?? "slh")"
                    AuthorName="SLH Collection"
                    TimeAgo="@gist.UpdatedAt.ToLocalTime().ToString("MMM dd, HH:mm:ss")"
                    Description="@(string.IsNullOrWhiteSpace(gist.Description) ? "Untitled snippet" : gist.Description)"
                    Tags="@gist.Tags"
                    SnippetPreview="@(gist.Files.Values.FirstOrDefault()?.Content ?? "Open details to view full file content.")"
                    Stars="0"
                    Forks="0"
                    OnView="@((id) => Navigation.NavigateTo($"/slh-collection/{gist.Id}"))"
                    OnClone="@(() => HandleClone(gist))"
                />
            }
        </div>
    }
</div>

@code {
    private const string SlhUsername = "sannlynnhtun-coding";
    private List<LocalGist> SlhGists = new();
    private bool IsLoading = false;
    private bool HasLoadError = false;
    private string ErrorMessage = "Unable to load SLH collection.";
    private string SearchQuery = "";
    private string Message = "";

    private List<LocalGist> FilteredGists => string.IsNullOrWhiteSpace(SearchQuery)
        ? SlhGists
        : SlhGists.Where(g =>
            (g.Description?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            g.Files.Values.Any(f => f.Filename?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            g.Tags.Any(t => t.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))
        ).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadCollection();
    }

    private async Task LoadCollection()
    {
        IsLoading = true;
        HasLoadError = false;
        ErrorMessage = "Unable to load SLH collection.";
        StateHasChanged();

        try
        {
            var token = AppState.CurrentProfile?.AccessToken;
            var gists = await Github.GetUserPublicGistsAsync(SlhUsername, token);
            if (Github.LastError != null)
            {
                HasLoadError = true;
                ErrorMessage = BuildGithubErrorMessage("SLH collection");
                return;
            }

            SlhGists = gists
                .Where(g => g.Public && string.Equals(g.Owner?.Login, SlhUsername, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(g => g.UpdatedAt)
                .ToList();

            foreach (var gist in SlhGists)
            {
                gist.Tags = ParseTags(gist.Description);
            }
        }
        catch
        {
            HasLoadError = true;
            ErrorMessage = "Failed to load SLH collection from GitHub.";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private string BuildGithubErrorMessage(string feedName)
    {
        if (Github.LastError?.IsRateLimited == true)
        {
            var retryText = Github.LastError.RateLimitReset is DateTimeOffset reset
                ? $" Try again after {reset.ToLocalTime():MMM dd, HH:mm}."
                : "";
            var authText = AppState.IsAuthenticated
                ? "Your GitHub token has reached its API rate limit."
                : "Connect GitHub to use your authenticated API limit.";

            return $"GitHub rate-limited the {feedName}. {authText}{retryText}";
        }

        if (Github.LastError?.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            return $"GitHub returned 403 Forbidden for the {feedName}. Connect GitHub or retry later.";
        }

        return "Failed to load SLH collection from GitHub.";
    }

    private async Task HandleClone(LocalGist gist)
    {
        if (!AppState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Message = "Cloning snippet...";
        StateHasChanged();

        try
        {
            var fullGist = await Github.GetGistByIdAsync(gist.Id, AppState.CurrentProfile!.AccessToken);
            if (fullGist == null ||
                !fullGist.Public ||
                !string.Equals(fullGist.Owner?.Login, SlhUsername, StringComparison.OrdinalIgnoreCase))
            {
                Message = "Clone failed: selected file is not in SLH public collection.";
                await ClearMessageAfterDelay();
                return;
            }

            var description = string.IsNullOrWhiteSpace(fullGist.Description)
                ? "Cloned from @slh"
                : $"{fullGist.Description} (Cloned from @slh)";

            var clone = await Github.CreateGistAsync(
                description,
                true,
                fullGist.Files,
                AppState.CurrentProfile!.AccessToken
            );

            if (clone == null)
            {
                Message = "Clone failed. Please try again.";
                await ClearMessageAfterDelay();
                return;
            }

            clone.IsSynced = true;
            clone.Tags = ParseTags(clone.Description);
            await Storage.SaveGistAsync(clone);

            Message = "Snippet cloned to your collection.";
            await ClearMessageAfterDelay();
        }
        catch
        {
            Message = "Clone failed due to a network or API error.";
            await ClearMessageAfterDelay();
        }
    }

    private async Task ClearMessageAfterDelay()
    {
        await Task.Delay(3000);
        Message = "";
        await InvokeAsync(StateHasChanged);
    }

    private List<string> ParseTags(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return new List<string>();
        }

        var tags = new List<string>();
        var parts = description.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        foreach (var part in parts)
        {
            if (part.StartsWith("#", StringComparison.Ordinal) && part.Length > 1)
            {
                tags.Add(part.Substring(1).TrimEnd(',', '.', '!', '?', ';', ':'));
            }
        }

        return tags;
    }
}
