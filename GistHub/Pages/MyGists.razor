@page "/my-gists"
@using GistHub.Components
@using GistHub.Models
@using GistHub.Services
@using System.Text.Json
@inject IStorageService Storage
@inject AppState AppState
@inject NavigationManager Navigation
@inject IGithubService Github
@inject IJSRuntime JS

<div class="neo-page relative space-y-12 pb-20">
    <button
        @onclick="ToggleProfileTools"
        class="neo-sidebar-toggle absolute top-0 right-0 z-10 !m-0"
        type="button"
        role="switch"
        aria-label="@(IsProfileToolsVisible ? "Hide profile and collection actions" : "Show profile and collection actions")"
        aria-checked="@IsProfileToolsVisible"
        aria-expanded="@(IsProfileToolsVisible ? "true" : "false")"
        aria-controls="profile-tools"
        title="@(IsProfileToolsVisible ? "Hide profile and collection actions" : "Show profile and collection actions")">
        <span class="neo-sidebar-toggle__label">Actions</span>
        <span class="neo-sidebar-toggle__options" aria-hidden="true">
            <span class="neo-sidebar-toggle__option @(IsProfileToolsVisible ? "is-selected" : "")"><span class="neo-sidebar-toggle__radio"></span>On</span>
            <span class="neo-sidebar-toggle__option @(!IsProfileToolsVisible ? "is-selected" : "")"><span class="neo-sidebar-toggle__radio"></span>Off</span>
        </span>
        <span class="sr-only">@(IsProfileToolsVisible ? "Hide profile and collection actions" : "Show profile and collection actions")</span>
    </button>

    <div id="profile-tools" hidden="@(!IsProfileToolsVisible)" class="@(IsProfileToolsVisible ? "flex" : "hidden") flex-col md:flex-row items-center justify-between gap-6 pb-8 pr-14 border-b !mt-0">
        <div class="flex items-center gap-6">
            @if (AppState.IsAuthenticated)
            {
                <div class="relative">
                    <div class="w-20 h-20 rounded-xl border border-border bg-muted overflow-hidden">
                        <img src="@($"https://github.com/{AppState.CurrentProfile?.GithubUsername}.png")" class="w-full h-full object-cover" />
                    </div>
                </div>
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <h1 class="text-2xl font-semibold tracking-tight">@AppState.CurrentProfile?.Name</h1>
                        <div class="px-1.5 py-0.5 rounded bg-[#EDF3EC] text-[#346538] text-[8px] font-bold uppercase tracking-widest border border-border">Verified</div>
                    </div>
                    <div class="flex items-center gap-4">
                        <span class="text-xs font-mono font-bold text-muted-foreground">@@@AppState.CurrentProfile?.GithubUsername</span>
                        <span class="w-1 h-1 rounded-full bg-border"></span>
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                            <span class="flex items-center gap-1"><span class="text-foreground">@TotalGistsCount</span> Gists</span>
                            <span class="flex items-center gap-1"><span class="text-[#346538]">@PublicGistsCount</span> Public</span>
                            <span class="flex items-center gap-1"><span class="text-[#956400]">@SecretGistsCount</span> Secret</span>
                            <span class="flex items-center gap-1"><span class="text-primary">@BookmarkedGistsCount</span> Bookmarks</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="flex items-center gap-3">
            <button @onclick="SyncGists" disabled="@IsSyncing" class="btn btn-secondary btn-md">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw @(IsSyncing ? "animate-spin" : "")"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
                Sync Cloud
            </button>
            <button @onclick="OpenImportDialog" disabled="@(!AppState.IsAuthenticated || IsImporting)" class="btn btn-outline btn-md">
                @if (IsImporting)
                {
                    <div class="w-4 h-4 border-2 border-current/30 border-t-current rounded-full animate-spin"></div>
                }
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-paste"><path d="M19 4h-3a2 2 0 0 0-4 0H9"/><path d="M5 7v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7"/><path d="M13 10H9"/><path d="M9 14h6"/><path d="M9 18h6"/></svg>
                Paste JSON
            </button>
            <button @onclick='() => Navigation.NavigateTo("/editor")' class="btn btn-primary btn-md">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus-circle"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
                New Snippet
            </button>
        </div>
    </div>

    <div class="relative group max-w-2xl mx-auto w-full @(IsProfileToolsVisible ? "-mt-6" : "!mt-0 pr-14 md:pr-0")">
        <div class="relative flex items-center bg-card border border-border rounded-xl px-4 py-2 transition-all focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search text-muted-foreground mr-3"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
                type="text"
                placeholder="Search your gists, files, or tags..."
                @bind="SearchQuery"
                @bind:event="oninput"
                class="flex-1 bg-transparent border-none outline-none text-sm font-medium placeholder:text-muted-foreground/50 h-10" />

            @if (!string.IsNullOrEmpty(SearchQuery))
            {
                <button @onclick='() => SearchQuery = ""' class="p-1.5 hover:bg-muted rounded-lg transition-all text-muted-foreground">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            }

            <button
                @onclick="ToggleBookmarksOnly"
                class="ml-2 h-11 px-3 inline-flex items-center gap-2 rounded-lg transition-colors @(BookmarksOnly ? "bg-accent text-accent-foreground" : "text-muted-foreground hover:bg-muted")"
                aria-label="Show bookmarked gists only"
                aria-pressed="@(BookmarksOnly ? "true" : "false")"
                title="Show bookmarked gists only">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="@(BookmarksOnly ? "currentColor" : "none")" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
                <span class="hidden sm:inline text-xs font-semibold">Bookmarks</span>
            </button>

            <div class="ml-4 pl-4 border-l border-border flex items-center gap-2">
                <span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/50">Filtered</span>
                <span class="text-xs font-bold tabular-nums">@FilteredGists.Count</span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(CollectionFilter))
    {
        <div class="flex items-center justify-between gap-3 max-w-2xl mx-auto w-full rounded-xl border bg-muted/20 px-4 py-3">
            <span class="text-sm font-semibold">Collection: @CollectionFilter</span>
            <a href="/my-gists" class="text-xs font-bold text-primary hover:underline">Show all gists</a>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(GroupMessage))
    {
        <div class="p-3 rounded-xl border border-border bg-[#FBF3DB] text-sm text-[#956400] font-semibold">@GroupMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(ImportMessage))
    {
        <div class="p-3 rounded-xl border text-sm font-semibold @(ImportWasSuccessful ? "border-border bg-[#EDF3EC] text-[#346538]" : "border-border bg-[#FDEBEC] text-[#9F2F2D]")">
            @ImportMessage
        </div>
    }

    @if (!AppState.IsAuthenticated)
    {
        <div class="flex flex-col items-center justify-center py-20 border border-dashed rounded-xl bg-[#FDEBEC]">
            <p class="text-sm font-medium text-destructive">You must be connected to GitHub to view your gists.</p>
            <button @onclick='() => Navigation.NavigateTo("/login")' class="mt-4 btn btn-primary btn-md">Connect Now</button>
        </div>
    }
    else if (!LocalGists.Any() && !IsSyncing)
    {
        <div class="flex flex-col items-center justify-center py-20 border border-dashed rounded-xl bg-muted/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-database-zap text-muted-foreground mb-4"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/><path d="M11 20l2-1h5l1 2"/></svg>
            <p class="text-sm font-medium text-muted-foreground">Pulling your gists from GitHub...</p>
        </div>
    }
    else
    {
        @if (!FilteredGists.Any())
        {
            <div class="flex flex-col items-center justify-center py-20 animate-in fade-in zoom-in duration-500">
                <div class="w-16 h-16 rounded-2xl bg-muted/20 flex items-center justify-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-x text-muted-foreground opacity-30"><path d="m13.5 8.5-5 5"/><path d="m8.5 8.5 5 5"/><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </div>
                <h3 class="text-lg font-bold">@(BookmarksOnly ? "No bookmarked gists found" : "No gists found")</h3>
                <p class="text-sm text-muted-foreground">@(BookmarksOnly ? "Bookmark a gist or turn off the filter." : "Try a different keyword or tag.")</p>
            </div>
        }
        else
        {
            <div class="gist-collection-grid" aria-label="@(BookmarksOnly ? "Reorderable bookmarked gists" : "Gists")">
                @foreach (var gist in FilteredGists)
                {
                    <div @key="gist.Id"
                         draggable="@BookmarksOnly"
                         class="@(BookmarksOnly ? $"bookmark-draggable {(DraggedBookmarkId == gist.Id ? "is-dragging" : "")} {(DropTargetBookmarkId == gist.Id ? "is-drop-target" : "")}" : "")"
                         @ondragstart="() => BeginBookmarkDrag(gist.Id)"
                         @ondragend="EndBookmarkDrag"
                         @ondragenter="() => SetBookmarkDropTarget(gist.Id)"
                         @ondragover:preventDefault="true"
                         @ondrop="() => DropBookmarkAsync(gist.Id)">
                        <GistCard
                            Id="@gist.Id"
                            ShowAuthorInfo="false"
                            Compact="true"
                            Description="@gist.Description"
                            Tags="@gist.Tags"
                            SnippetPreview="@(gist.Files.Values.FirstOrDefault()?.Content ?? "")"
                            Stars="0"
                            Forks="0"
                            IsPublic="@gist.Public"
                            ShowVisibilityToggle="true"
                            OnVisibilityChanged="@(isPublic => SetVisibility(gist, isPublic))"
                            IsBookmarked="@gist.IsBookmarked"
                            EnableGroupPicker="true"
                            AvailableGroups="@GroupNames"
                            SelectedGroups="@gist.CollectionNames"
                            OnCreateGroup="@(name => CreateGroupFromCard(name))"
                            OnToggleGroupOn="@(name => AddGroupToGist(gist, name))"
                            OnToggleGroupOff="@(name => RemoveGroupFromGist(gist, name))"
                            OnEdit="@(() => Navigation.NavigateTo($"/editor/{gist.Id}"))"
                            OnDelete="@(() => HandleDelete(gist))"
                            OnCopyRaw="@(() => HandleCopyRaw(gist))"
                            IsCopied="@(CopiedGistId == gist.Id)"
                            OnToggleBookmark="@(() => ToggleBookmark(gist))"
                            OnView="@((id) => Navigation.NavigateTo($"/view/{gist.Id}"))"
                        />
                    </div>
                }
            </div>
        }
    }
</div>

@if (IsImportDialogOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 md:p-6" @onkeydown="HandleImportDialogKeyDown">
        <button class="absolute inset-0 bg-black/40 backdrop-blur-sm cursor-default" aria-label="Close import dialog" @onclick="CloseImportDialog"></button>
        <div class="relative w-full max-w-4xl bg-card border border-border rounded-xl p-5 md:p-8 space-y-4">
            <div class="flex items-start justify-between gap-4">
                <div class="space-y-1">
                    <h2 class="text-xl font-semibold tracking-tight">Paste Gist JSON</h2>
                    <p class="text-sm text-muted-foreground">Paste an object with <code>description</code>, <code>public</code>, and <code>files</code>.</p>
                </div>
                <button @onclick="CloseImportDialog" class="p-2 rounded-lg hover:bg-muted transition-colors text-muted-foreground" title="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>

            <textarea
                @bind="ImportJsonText"
                @bind:event="oninput"
                rows="16"
                spellcheck="false"
                placeholder='{"description":"...","public":false,"files":{"file.md":{"content":"..."}}}'
                class="w-full bg-secondary/30 border rounded-lg p-4 focus:ring-2 focus:ring-primary/10 outline-none transition-all text-sm font-mono resize-y custom-scrollbar"></textarea>

            @if (!string.IsNullOrWhiteSpace(ImportValidationMessage))
            {
                <p class="text-sm text-destructive font-medium">@ImportValidationMessage</p>
            }

            <div class="flex items-center justify-end gap-2 pt-2">
                <button @onclick="CloseImportDialog" disabled="@IsImporting" class="btn btn-outline btn-md">Cancel</button>
                <button @onclick="ImportGistFromJsonAsync" disabled="@IsImporting" class="btn btn-primary btn-md">
                    @if (IsImporting)
                    {
                        <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                    }
                    Save to Gist
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const string BookmarksOnlyStorageKey = "gisthub:bookmarks-only";
    private const string ProfileToolsVisibleStorageKey = "gisthub:profile-tools-visible";

    [Parameter]
    [SupplyParameterFromQuery(Name = "favorites")]
    public bool FavoritesOnly { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "collection")]
    public string? CollectionFilter { get; set; }

    private static readonly JsonSerializerOptions ImportJsonOptions = new(JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true
    };

    private List<LocalGist> LocalGists = new();
    private List<GistGroup> Groups = new();
    private bool IsSyncing = false;
    private bool IsProfileToolsVisible = true;
    private bool BookmarksOnly = false;
    private string SearchQuery = "";
    private string GroupMessage = "";
    private bool IsImportDialogOpen = false;
    private bool IsImporting = false;
    private bool ImportWasSuccessful = false;
    private string ImportJsonText = "";
    private string ImportValidationMessage = "";
    private string ImportMessage = "";
    private string? CopiedGistId = null;
    private string? DraggedBookmarkId = null;
    private string? DropTargetBookmarkId = null;

    private List<string> GroupNames => Groups.Select(g => g.Name).ToList();

    private List<LocalGist> FilteredGists => LocalGists.Where(g =>
        (!BookmarksOnly || g.IsBookmarked) &&
        (string.IsNullOrWhiteSpace(CollectionFilter) ||
         g.CollectionNames.Any(name => string.Equals(name, CollectionFilter, StringComparison.OrdinalIgnoreCase))) &&
        (string.IsNullOrWhiteSpace(SearchQuery) ||
         (g.Description?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
         g.Files.Values.Any(f => f.Filename?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
         g.Tags.Any(t => t.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
    )
    .OrderBy(g => BookmarksOnly && g.IsBookmarked && g.BookmarkOrder > 0 ? 0 : 1)
    .ThenBy(g => BookmarksOnly && g.IsBookmarked && g.BookmarkOrder > 0 ? g.BookmarkOrder : int.MaxValue)
    .ThenByDescending(g => g.UpdatedAt)
    .ToList();

    private int TotalGistsCount => LocalGists.Count;
    private int PublicGistsCount => LocalGists.Count(g => g.Public);
    private int SecretGistsCount => LocalGists.Count(g => !g.Public);
    private int BookmarkedGistsCount => LocalGists.Count(g => g.IsBookmarked);

    private async Task ToggleProfileTools()
    {
        IsProfileToolsVisible = !IsProfileToolsVisible;
        await JS.InvokeVoidAsync("localStorage.setItem", ProfileToolsVisibleStorageKey, IsProfileToolsVisible ? "true" : "false");
    }

    private async Task ToggleBookmarksOnly()
    {
        BookmarksOnly = !BookmarksOnly;
        FavoritesOnly = false;
        await JS.InvokeVoidAsync("localStorage.setItem", BookmarksOnlyStorageKey, BookmarksOnly ? "true" : "false");
    }

    protected override async Task OnInitializedAsync()
    {
        BookmarksOnly = FavoritesOnly;
        await LoadLocalGists();
        await LoadGroups();

        if (AppState.IsAuthenticated && !LocalGists.Any())
        {
            await SyncGists();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!FavoritesOnly && string.IsNullOrWhiteSpace(CollectionFilter))
        {
            var storedValue = await JS.InvokeAsync<string?>("localStorage.getItem", BookmarksOnlyStorageKey);
            BookmarksOnly = string.Equals(storedValue, "true", StringComparison.OrdinalIgnoreCase);
        }

        var profileToolsStoredValue = await JS.InvokeAsync<string?>("localStorage.getItem", ProfileToolsVisibleStorageKey);
        IsProfileToolsVisible = !string.Equals(profileToolsStoredValue, "false", StringComparison.OrdinalIgnoreCase);
        StateHasChanged();
    }

    private async Task LoadLocalGists()
    {
        LocalGists = (await Storage.GetLocalGistsAsync())
                      .OrderByDescending(g => g.UpdatedAt)
                      .ToList();
    }

    private async Task LoadGroups()
    {
        Groups = await Storage.GetGroupsAsync();
    }

    private async Task SyncGists()
    {
        if (!AppState.IsAuthenticated) return;

        IsSyncing = true;
        StateHasChanged();

        try
        {
            var existingById = LocalGists
                .Where(g => !string.IsNullOrWhiteSpace(g.Id))
                .GroupBy(g => g.Id)
                .Select(group => group.First())
                .ToDictionary(g => g.Id, g => g);

            var userGistsList = await Github.GetUserGistsAsync(AppState.CurrentProfile!.AccessToken);
            if (userGistsList != null)
            {
                var tasks = userGistsList.Select(async gist =>
                {
                    var fullGist = await Github.GetGistByIdAsync(gist.Id, AppState.CurrentProfile!.AccessToken);
                    if (fullGist == null)
                    {
                        return;
                    }

                    fullGist.IsSynced = true;
                    fullGist.Tags = ParseTags(fullGist.Description);

                    if (existingById.TryGetValue(fullGist.Id, out var existing))
                    {
                        fullGist.IsBookmarked = existing.IsBookmarked;
                        fullGist.BookmarkOrder = existing.BookmarkOrder;
                        fullGist.CollectionNames = existing.CollectionNames
                            .Distinct(StringComparer.OrdinalIgnoreCase)
                            .ToList();
                        fullGist.CollectionName = fullGist.CollectionNames.FirstOrDefault();
                    }

                    await Storage.SaveGistAsync(fullGist);
                });

                await Task.WhenAll(tasks);
                await LoadLocalGists();
                await LoadGroups();
            }
        }
        finally
        {
            IsSyncing = false;
            StateHasChanged();
        }
    }

    private async Task HandleDelete(LocalGist gist)
    {
        if (string.IsNullOrEmpty(gist.Id)) return;

        var gistLabel = string.IsNullOrWhiteSpace(gist.Description) ? gist.Id : gist.Description;
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete this gist?\n\n{gistLabel}\n\nThis action cannot be undone.");
        if (!confirmed)
        {
            return;
        }

        LocalGists.Remove(gist);
        await Storage.DeleteGistAsync(gist.Id);
        StateHasChanged();

        if (AppState.IsAuthenticated)
        {
            await Github.DeleteGistAsync(gist.Id, AppState.CurrentProfile!.AccessToken);
        }
    }

    private List<string> ParseTags(string description)
    {
        if (string.IsNullOrEmpty(description)) return new List<string>();
        var tags = new List<string>();
        var parts = description.Split(' ');
        foreach (var part in parts)
        {
            if (part.StartsWith("#") && part.Length > 1)
                tags.Add(part.Substring(1).TrimEnd(',', '.', '!', '?', ';'));
        }
        return tags;
    }

    private async Task ToggleBookmark(LocalGist gist)
    {
        gist.IsBookmarked = !gist.IsBookmarked;
        if (gist.IsBookmarked)
        {
            gist.BookmarkOrder = LocalGists
                .Where(item => item.IsBookmarked)
                .Select(item => item.BookmarkOrder)
                .DefaultIfEmpty()
                .Max() + 1;
        }
        else
        {
            gist.BookmarkOrder = 0;
        }
        await Storage.SaveGistAsync(gist);
        StateHasChanged();
    }

    private async Task SetVisibility(LocalGist gist, bool isPublic)
    {
        if (gist.Public == isPublic)
        {
            return;
        }

        gist.Public = isPublic;
        await Storage.SaveGistAsync(gist);
        StateHasChanged();
    }

    private void BeginBookmarkDrag(string gistId)
    {
        if (!BookmarksOnly)
        {
            return;
        }

        DraggedBookmarkId = gistId;
        DropTargetBookmarkId = gistId;
    }

    private void SetBookmarkDropTarget(string gistId)
    {
        if (BookmarksOnly && DraggedBookmarkId is not null)
        {
            DropTargetBookmarkId = gistId;
        }
    }

    private void EndBookmarkDrag()
    {
        DraggedBookmarkId = null;
        DropTargetBookmarkId = null;
    }

    private async Task DropBookmarkAsync(string targetId)
    {
        if (!BookmarksOnly || string.IsNullOrWhiteSpace(DraggedBookmarkId) || DraggedBookmarkId == targetId)
        {
            EndBookmarkDrag();
            return;
        }

        var orderedBookmarks = LocalGists
            .Where(gist => gist.IsBookmarked)
            .OrderBy(gist => gist.BookmarkOrder > 0 ? 0 : 1)
            .ThenBy(gist => gist.BookmarkOrder > 0 ? gist.BookmarkOrder : int.MaxValue)
            .ThenByDescending(gist => gist.UpdatedAt)
            .ToList();
        var dragged = orderedBookmarks.FirstOrDefault(gist => gist.Id == DraggedBookmarkId);
        var targetIndex = orderedBookmarks.FindIndex(gist => gist.Id == targetId);

        if (dragged is not null && targetIndex >= 0)
        {
            orderedBookmarks.Remove(dragged);
            targetIndex = orderedBookmarks.FindIndex(gist => gist.Id == targetId);
            orderedBookmarks.Insert(targetIndex, dragged);

            for (var index = 0; index < orderedBookmarks.Count; index++)
            {
                orderedBookmarks[index].BookmarkOrder = index + 1;
            }

            await Task.WhenAll(orderedBookmarks.Select(Storage.SaveGistAsync));
        }

        EndBookmarkDrag();
        StateHasChanged();
    }

    private async Task HandleCopyRaw(LocalGist gist)
    {
        var content = gist.Files.Values.FirstOrDefault()?.Content;
        if (string.IsNullOrEmpty(content)) return;

        await JS.InvokeVoidAsync("copyToClipboard", content);
        CopiedGistId = gist.Id;
        StateHasChanged();

        await Task.Delay(2000);
        if (CopiedGistId == gist.Id)
        {
            CopiedGistId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CreateGroupFromCard(string groupName)
    {
        var normalized = NormalizeGroupName(groupName);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            GroupMessage = "Group name is required.";
            await ClearGroupMessageAfterDelay();
            return;
        }

        if (Groups.Any(g => string.Equals(g.Name, normalized, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        var group = new GistGroup
        {
            Name = normalized,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow
        };

        await Storage.SaveGroupAsync(group);
        await LoadGroups();
        StateHasChanged();
    }

    private async Task AddGroupToGist(LocalGist gist, string groupName)
    {
        var normalized = NormalizeGroupName(groupName);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return;
        }

        gist.CollectionNames ??= new List<string>();
        if (gist.CollectionNames.Any(name => string.Equals(name, normalized, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        gist.CollectionNames.Add(normalized);
        gist.CollectionNames = gist.CollectionNames
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        gist.CollectionName = gist.CollectionNames.FirstOrDefault();

        await Storage.SaveGistAsync(gist);
        StateHasChanged();
    }

    private async Task RemoveGroupFromGist(LocalGist gist, string groupName)
    {
        var normalized = NormalizeGroupName(groupName);
        gist.CollectionNames = gist.CollectionNames
            .Where(name => !string.Equals(name, normalized, StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        gist.CollectionName = gist.CollectionNames.FirstOrDefault();

        await Storage.SaveGistAsync(gist);
        StateHasChanged();
    }

    private async Task ClearGroupMessageAfterDelay()
    {
        await Task.Delay(2500);
        GroupMessage = "";
        await InvokeAsync(StateHasChanged);
    }

    private void OpenImportDialog()
    {
        ImportValidationMessage = "";
        ImportWasSuccessful = false;
        ImportMessage = "";
        IsImportDialogOpen = true;
    }

    private void CloseImportDialog()
    {
        if (IsImporting)
        {
            return;
        }

        ImportValidationMessage = "";
        IsImportDialogOpen = false;
    }

    private async Task ImportGistFromJsonAsync()
    {
        ImportValidationMessage = "";
        ImportMessage = "";
        ImportWasSuccessful = false;

        if (!AppState.IsAuthenticated || string.IsNullOrWhiteSpace(AppState.CurrentProfile?.AccessToken))
        {
            ImportValidationMessage = "Connect to GitHub before importing.";
            return;
        }

        if (!TryParseImportJson(ImportJsonText, out var description, out var isPublic, out var files, out var validationError))
        {
            ImportValidationMessage = validationError;
            return;
        }

        IsImporting = true;
        StateHasChanged();

        try
        {
            var createdGist = await Github.CreateGistAsync(description, isPublic, files, AppState.CurrentProfile!.AccessToken);
            if (createdGist == null)
            {
                var message = Github.LastError?.Message;
                ImportValidationMessage = string.IsNullOrWhiteSpace(message)
                    ? "GitHub API rejected this payload."
                    : $"GitHub API error: {message}";
                return;
            }

            createdGist.IsSynced = true;
            createdGist.Tags = ParseTags(createdGist.Description);

            await Storage.SaveGistAsync(createdGist);
            await LoadLocalGists();

            ImportJsonText = "";
            IsImportDialogOpen = false;
            ImportWasSuccessful = true;
            ImportMessage = $"Imported successfully: {createdGist.Id}";
        }
        catch (JsonException ex)
        {
            ImportValidationMessage = $"Invalid JSON: {ex.Message}";
        }
        catch (Exception ex)
        {
            ImportValidationMessage = $"Import failed: {ex.Message}";
        }
        finally
        {
            IsImporting = false;
            StateHasChanged();
        }
    }

    private static bool TryParseImportJson(
        string json,
        out string description,
        out bool isPublic,
        out Dictionary<string, GistFile> files,
        out string validationError)
    {
        description = string.Empty;
        isPublic = false;
        files = new Dictionary<string, GistFile>(StringComparer.Ordinal);
        validationError = string.Empty;

        if (string.IsNullOrWhiteSpace(json))
        {
            validationError = "Paste JSON content first.";
            return false;
        }

        ImportedGistPayload? payload;
        try
        {
            payload = JsonSerializer.Deserialize<ImportedGistPayload>(json, ImportJsonOptions);
        }
        catch (JsonException ex)
        {
            validationError = $"Invalid JSON: {ex.Message}";
            return false;
        }

        if (payload == null)
        {
            validationError = "JSON payload is empty.";
            return false;
        }

        if (payload.Files == null || payload.Files.Count == 0)
        {
            validationError = "At least one file is required in files.";
            return false;
        }

        foreach (var fileEntry in payload.Files)
        {
            var filename = (fileEntry.Key ?? string.Empty).Trim();
            if (string.IsNullOrWhiteSpace(filename))
            {
                validationError = "All file names must be non-empty.";
                return false;
            }

            if (files.ContainsKey(filename))
            {
                validationError = $"Duplicate filename found: {filename}";
                return false;
            }

            if (fileEntry.Value == null)
            {
                validationError = $"File entry '{filename}' is invalid.";
                return false;
            }

            files[filename] = new GistFile
            {
                Filename = filename,
                Content = fileEntry.Value.Content ?? string.Empty
            };
        }

        description = payload.Description?.Trim() ?? string.Empty;
        isPublic = payload.Public;
        return true;
    }

    private void HandleImportDialogKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseImportDialog();
        }
    }

    private static string NormalizeGroupName(string? name)
        => (name ?? string.Empty).Trim();

    private sealed class ImportedGistPayload
    {
        public string? Description { get; set; }
        public bool Public { get; set; }
        public Dictionary<string, ImportedGistFile>? Files { get; set; }
    }

    private sealed class ImportedGistFile
    {
        public string? Content { get; set; }
    }
}
