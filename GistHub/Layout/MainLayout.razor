@inherits LayoutComponentBase

<div class="neo-app-shell relative min-h-screen flex bg-background text-foreground"
     aria-hidden="@(IsUtilityOpen ? "true" : null)"
     inert="@(IsUtilityOpen ? "" : null)">
    <!-- Sidebar -->
    <NavMenu IsVisible="@IsSidebarVisible" />

    <!-- Main Content -->
    <main class="neo-main flex-1 flex flex-col min-w-0 h-screen overflow-hidden">
        <!-- Topbar -->
        <header class="neo-topbar flex items-center justify-between px-6 glass sticky top-0 z-40">
            <div class="neo-topbar-brand flex items-center gap-4">
                <div class="neo-brand-mark md:hidden w-9 h-9 overflow-hidden rounded-md">
                    <img src="logo.svg" class="w-full h-full object-cover" alt="" />
                </div>
                <div>
                    <div class="neo-kicker mb-1">Code stash</div>
                    <h1 class="text-xl font-black tracking-tight">GistHub</h1>
                </div>
            </div>
            
            <div class="neo-topbar-actions flex items-center gap-3">
                <button @onclick="ToggleSidebar" class="neo-sidebar-toggle hidden md:inline-flex" type="button" role="switch" aria-checked="@IsSidebarVisible" title="@(IsSidebarVisible ? "Hide sidebar" : "Show sidebar")">
                    <span class="neo-sidebar-toggle__label">Sidebar</span>
                    <span class="neo-sidebar-toggle__options" aria-hidden="true">
                        <span class="neo-sidebar-toggle__option @(IsSidebarVisible ? "is-selected" : "")"><span class="neo-sidebar-toggle__radio"></span>On</span>
                        <span class="neo-sidebar-toggle__option @(!IsSidebarVisible ? "is-selected" : "")"><span class="neo-sidebar-toggle__radio"></span>Off</span>
                    </span>
                    <span class="sr-only">@(IsSidebarVisible ? "Hide sidebar" : "Show sidebar")</span>
                </button>
                <button @ref="JsonParserTrigger" @onclick="OpenJsonParser" class="neo-json-parser-trigger" type="button" title="Open JSON parser">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1" />
                        <path d="M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1" />
                    </svg>
                    <span class="hidden xl:inline">JSON Parser</span>
                    <span class="sr-only xl:hidden">JSON Parser</span>
                </button>
                <button @ref="CodeImageTrigger" @onclick="OpenCodeImage" class="neo-code-image-trigger" type="button" title="Open code to image">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect width="18" height="18" x="3" y="3" rx="2" />
                        <path d="m9 9-3 3 3 3" />
                        <path d="m15 9 3 3-3 3" />
                    </svg>
                    <span class="hidden xl:inline">Code Image</span>
                    <span class="sr-only xl:hidden">Code to Image</span>
                </button>
                <NavLink href="editor" class="neo-new-snippet btn btn-primary btn-md" title="Create a new snippet">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14" />
                        <path d="M5 12h14" />
                    </svg>
                    <span class="hidden xl:inline">New Snippet</span>
                    <span class="sr-only xl:hidden">New Snippet</span>
                </NavLink>
                <SoundToggle />
                <ThemeToggle />
                <button class="neo-topbar-search neo-icon-button p-2 bg-card hover:bg-accent rounded-md transition-all text-foreground" title="Toggle Search (Ctrl+K)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </button>
                <div class="neo-online-divider hidden sm:block h-6 w-[2px] bg-border mx-1"></div>
                <button class="neo-online-status hidden sm:flex items-center gap-2 px-3 py-1.5 bg-card border-2 text-foreground hover:bg-secondary hover:text-secondary-foreground rounded-md text-xs font-black uppercase tracking-wider transition-all">
                    <div class="w-2 h-2 rounded-full bg-[#346538]"></div>
                    Online
                </button>
            </div>
        </header>

        <!-- Scrollable Area -->
        <div class="neo-canvas flex-1 overflow-y-auto p-6 md:p-10 custom-scrollbar">
            <div class="neo-decor neo-decor--pink" aria-hidden="true"></div>
            <div class="neo-decor neo-decor--purple" aria-hidden="true"></div>
            <div class="neo-content max-w-6xl mx-auto space-y-10 animate-in fade-in duration-500">
                @Body
            </div>
        </div>
    </main>
</div>

<JsonParserOverlay IsOpen="@IsJsonParserOpen" OnClose="CloseJsonParser" />
<CodeImageOverlay IsOpen="@IsCodeImageOpen" OnClose="CloseCodeImage" />

@inject AppState AppState
@inject IStorageService Storage
@inject IJSRuntime JS

@code {
    private const string SidebarVisibleStorageKey = "gisthub:sidebar-visible";

    private bool IsSidebarVisible { get; set; } = true;
    private bool IsJsonParserOpen { get; set; }
    private bool IsCodeImageOpen { get; set; }
    private bool ShouldRestoreJsonParserFocus { get; set; }
    private bool ShouldRestoreCodeImageFocus { get; set; }
    private ElementReference JsonParserTrigger { get; set; }
    private ElementReference CodeImageTrigger { get; set; }
    private bool IsUtilityOpen => IsJsonParserOpen || IsCodeImageOpen;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated)
        {
            var profiles = await Storage.GetProfilesAsync();
            if (profiles != null && profiles.Any())
            {
                // Auto-restore the last used session
                AppState.SetProfile(profiles.First());
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var storedValue = await JS.InvokeAsync<string?>("localStorage.getItem", SidebarVisibleStorageKey);
            IsSidebarVisible = !string.Equals(storedValue, "false", StringComparison.OrdinalIgnoreCase);
            StateHasChanged();
        }

        if (ShouldRestoreJsonParserFocus)
        {
            ShouldRestoreJsonParserFocus = false;
            await JsonParserTrigger.FocusAsync();
        }

        if (ShouldRestoreCodeImageFocus)
        {
            ShouldRestoreCodeImageFocus = false;
            await CodeImageTrigger.FocusAsync();
        }
    }

    private async Task ToggleSidebar()
    {
        IsSidebarVisible = !IsSidebarVisible;
        await JS.InvokeVoidAsync("localStorage.setItem", SidebarVisibleStorageKey, IsSidebarVisible ? "true" : "false");
    }

    private void OpenJsonParser()
    {
        IsJsonParserOpen = true;
    }

    private void CloseJsonParser()
    {
        IsJsonParserOpen = false;
        ShouldRestoreJsonParserFocus = true;
    }

    private void OpenCodeImage()
    {
        IsCodeImageOpen = true;
    }

    private void CloseCodeImage()
    {
        IsCodeImageOpen = false;
        ShouldRestoreCodeImageFocus = true;
    }
}
